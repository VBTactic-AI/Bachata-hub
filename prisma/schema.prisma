// ============================================================================
// Bachata HUB Belarus — слой 1 (агрегатор: календарь, школы, профиль танцора)
// ============================================================================
// Архитектурный принцип: схема проектируется так, чтобы слой 2 (оплата,
// подтверждённая регистрация через ЕРИП/bePaid) и слой 3 (судейство конкурсов
// Jack&Jill/Strictly/Solo Battle, автоматические достижения) подключались
// НОВЫМИ таблицами и связями, без миграции существующих данных и без смены
// смысла существующих полей. Места, зарезервированные под будущее, отмечены
// комментарием "СЛОЙ 2" / "СЛОЙ 3".
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  // relationJoins — вложенные include собираются в один SQL-запрос (LATERAL
  // JOIN) вместо отдельного запроса на каждый уровень вложенности. Каждый
  // round-trip к БД (Supabase pooler) стоит ~150мс сам по себе (замерено),
  // так что меньше запросов = кратно быстрее для "тяжёлых" страниц с
  // глубоко вложенными данными (карточка соревнования и т.п.). Preview-фича
  // Prisma 5.18, включается явно на запрос через relationLoadStrategy: "join"
  // (не глобально по умолчанию) — см. вызовы, где применена.
  //
  // ВАЖНО (найдено 2026-09-08, воспроизводится 10/10): relationLoadStrategy:
  // "join" НЕЛЬЗЯ использовать вместе с findUnique/findUniqueOrThrow.
  // Prisma автоматически склеивает одновременные findUnique в один batch
  // (dataloader), и на batch'е с join-стратегией query-engine 5.18 падает с
  // PANIC ("called `Option::unwrap()` on a `None` value",
  // query_document/mod.rs) — наружу это уходит как "Внутренняя ошибка
  // сервера" (500). Достаточно ДВУХ одновременных запросов одной формы —
  // например, два судьи открыли свой экран в одну секунду, или два админа
  // карточку соревнования; параметры могут быть разными.
  // connection_limit=1 от этого НЕ защищает: паника происходит при сборке
  // запроса, ещё до получения соединения из пула.
  //
  // Поэтому все такие вызовы в проекте используют findFirst/findFirstOrThrow
  // (по уникальному полю в where — та же одна строка, но без батчинга).
  // findFirst/findMany с join безопасны (проверено 0/10 паник).
  // Если добавляете новый запрос с relationLoadStrategy: "join" — не
  // findUnique. Ограничение снимется после апгрейда Prisma (relationJoins
  // стала стабильной в 6.x) — тогда это правило можно перепроверить.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL — transaction-pooler Supabase (:6543, pgbouncer=true),
  // для обычных запросов приложения в рантайме — им и остаётся.
  url       = env("DATABASE_URL")
  // directUrl — используется ТОЛЬКО Prisma CLI (migrate dev/deploy, db execute,
  // introspect), не рантаймом. Через transaction-pooler `prisma migrate deploy`
  // виснет/падает — миграциям нужны сессионные фичи (advisory locks),
  // которых pgbouncer в transaction-режиме не даёт. См. .env.example —
  // DIRECT_URL берётся из Supabase Dashboard → Database → Connection string
  // → "Session pooler" или "Direct connection" (без pgbouncer=true).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Пользователи и роли
// ---------------------------------------------------------------------------

enum UserRole {
  GUEST // не хранится в БД, используется только в коде авторизации
  DANCER
  SCHOOL_REP
  ORGANIZER
  MODERATOR
  ADMIN
}

model User {
  id                          String    @id @default(cuid())
  email                       String    @unique
  // Nullable — источник истины для аутентификации теперь Supabase Auth
  // (см. supabaseUserId ниже); свой bcrypt-хэш остаётся только у записей,
  // созданных ДО перехода, и у служебных аккаунтов, которых организатор
  // добавляет вручную без приглашения (registerByAdmin — заводит случайный
  // непроходимый хэш, т.к. этот человек никогда не логинится сам).
  passwordHash                String?
  // Мост на auth.users.id (Supabase Auth) — null, пока пользователь ни разу
  // не входил через Supabase Auth (Google/Apple/email). Заполняется один раз
  // в src/app/auth/callback/route.ts: либо у уже существующей записи (по
  // совпадению email — no-duplicate-account линковка), либо у только что
  // созданной. UNIQUE — одна запись Supabase Auth не может быть связана с
  // двумя разными public.User.
  supabaseUserId              String?   @unique
  role                        UserRole  @default(DANCER)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  lastLoginAt                 DateTime?
  isBlocked                   Boolean   @default(false)
  // Проверенный доступ, выдаваемый ТОЛЬКО через одобрение AccessRequest
  // супер-админом (не выбирается пользователем сам, см. docs/00_DECISIONS.md
  // и /become-organizer) — расширяет canCreateEvents()/доступ к /admin/festival.
  isVerifiedEventOrganizer    Boolean   @default(false)
  isVerifiedFestivalOrganizer Boolean   @default(false)

  dancer                      Dancer?
  ownedSchools                School[]                @relation("SchoolOwner")
  createdEvents               Event[]                 @relation("EventCreator")
  moderatedEvents             Event[]                 @relation("EventModerator")
  createdEventTemplates       EventTemplate[]         @relation("EventTemplateCreator")
  createdEventSeries          EventSeries[]           @relation("EventSeriesCreator")
  createdFestivals            Festival[]              @relation("FestivalCreator")
  reviews                     Review[]                @relation("ReviewAuthor")
  moderatedReviews            Review[]                @relation("ReviewModerator")
  moderationLogs              ModerationLog[]         @relation("ModerationActor")
  accessRequestsSubmitted     AccessRequest[]         @relation("AccessRequestApplicant")
  accessRequestsReviewed      AccessRequest[]         @relation("AccessRequestReviewer")
  eventTeamMemberships        EventTeamMember[]       @relation("EventTeamMemberUser")
  eventTeamInvitesSent        EventTeamMember[]       @relation("EventTeamMemberInvitedBy")
  eventSuggestionsSubmitted   EventSuggestion[]       @relation("EventSuggestionSubmitter")
  eventSuggestionsReviewed    EventSuggestion[]       @relation("EventSuggestionReviewer")
  eventRegistrationsCheckedIn EventRegistration[]     @relation("EventRegistrationCheckedInBy")
  ticketsIssued               Ticket[]                @relation("TicketIssuedBy")
  passTemplatesCreated        PassTemplate[]          @relation("PassTemplateCreatedBy")
  festivalQuestionsModerated  FestivalGuestQuestion[] @relation("FestivalGuestQuestionModerator")
  festivalQuestionsAnswered   FestivalGuestQuestion[] @relation("FestivalGuestQuestionAnswerer")
  // Commerce Engine v1 (2026-09-17) — см. комментарий у моделей Order/Payment/
  // Refund/TicketCheckIn.
  ordersCreated               Order[]                 @relation("OrderCreatedBy")
  paymentsRecorded            Payment[]               @relation("PaymentRecordedBy")
  refundsRecorded             Refund[]                @relation("RefundRecordedBy")
  ticketCheckInsPerformed     TicketCheckIn[]         @relation("TicketCheckedInBy")
  // "Продажа на входе" (2026-09-18) — см. комментарий у модели DoorSale.
  doorSalesRecorded           DoorSale[]              @relation("DoorSaleRecordedBy")

  // --- Слой 3: движок соревнований Jack & Jill (RBAC + аудит) ---
  // Отдельная система прав от layer-1 UserRole выше (см. docs/00_DECISIONS.md, D2):
  // UserRole управляет модерацией афиши/школ, а роли ниже — доступом внутри
  // конкретных соревнований (EVENT_ADMIN, HEAD_JUDGE, JUDGE, ...).
  competitionRoleAssignments UserRoleAssignment[] @relation("UserRoleAssignee")
  grantedRoleAssignments     UserRoleAssignment[] @relation("UserRoleGrantor")
  competitionMemberships     CompetitionMember[]  @relation("CompetitionMemberUser")
  grantedCompetitionMembers  CompetitionMember[]  @relation("CompetitionMemberGrantor")
  createdCompetitions        Competition[]        @relation("CompetitionCreator")
  lockedCompetitionRules     CompetitionRules[]   @relation("CompetitionRulesLocker")
  competitionAuditLogs       AuditLog[]           @relation("AuditLogActor")
  competitionEvents          CompetitionEvent[]   @relation("CompetitionEventActor")
  registrationsMade          Registration[]       @relation("RegistrationRegisteredBy")
  checkInsPerformed          CheckIn[]            @relation("CheckInCheckedInBy")
  roleOverridesReviewed      Registration[]       @relation("RegistrationRoleOverrideReviewer")
  drawsCreated               Draw[]               @relation("DrawCreatedBy")
  judgeAssignments           JudgeAssignment[]    @relation("JudgeAssignmentJudge")
  assignedJudgeAssignments   JudgeAssignment[]    @relation("JudgeAssignmentAssignedBy")
  createdFinalPairs          FinalPair[]          @relation("FinalPairCreatedBy")
  reviewedDivisionResults    Division[]           @relation("DivisionResultsReviewedBy")
  publishedRoundAdvancements Round[]              @relation("RoundAdvancementPublishedBy")
  publishedResults           Result[]             @relation("ResultPublishedBy")
  createdResults             Result[]             @relation("ResultCreatedBy")
  audienceVoteBallotsCast    AudienceVoteBallot[] @relation("AudienceVoteBallotVoter")
  startedAudienceVotes       AudienceVote[]       @relation("AudienceVoteStartedBy")
  closedAudienceVotes        AudienceVote[]       @relation("AudienceVoteClosedBy")
  publishedAudienceVotes     AudienceVote[]       @relation("AudienceVotePublishedBy")
  confirmedAudienceWinners   AudienceVoteWinner[] @relation("AudienceVoteWinnerConfirmedBy")

  // --- Notification & Subscription Engine ---
  // Независимый модуль, реагирует на доменные события Event Engine и слоя 3,
  // не переиспользует и не дублирует их модели.
  subscriptions                    Subscription[]
  notificationPreference           NotificationPreference?
  notificationEndpoints            NotificationEndpoint[]
  notifications                    Notification[]
  notificationChannelPricesUpdated NotificationChannelPrice[] @relation("NotificationChannelPriceUpdatedBy")
  broadcastsSent                   Broadcast[]
  telegramLinkTokens               TelegramLinkToken[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// Справочники
// ---------------------------------------------------------------------------

model Country {
  // СЛОЙ будущего расширения на СНГ — сегодня используется только Беларусь,
  // но City ссылается на Country с самого начала, чтобы не переделывать схему.
  id     String @id @default(cuid())
  code   String @unique // ISO 3166-1 alpha-2, напр. "BY", "RU", "PL"
  nameRu String

  cities         City[]
  accessRequests AccessRequest[]
}

model City {
  id        String  @id @default(cuid())
  slug      String  @unique // человекочитаемый URL: /minsk, /gomel
  nameRu    String
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  isActive  Boolean @default(true) // видна ли в переключателе городов на старте

  schools          School[]
  events           Event[]
  dancers          Dancer[]
  schoolBranches   SchoolBranch[]
  competitions     Competition[]
  accessRequests   AccessRequest[]
  eventSuggestions EventSuggestion[]
  eventTemplates   EventTemplate[]
  eventSeries      EventSeries[]
  festivals        Festival[]

  @@index([countryId])
}

// ---------------------------------------------------------------------------
// Школы
// ---------------------------------------------------------------------------

enum SchoolVerificationStatus {
  COMMUNITY // «профиль создан сообществом» — карточку никто не подтвердил
  VERIFIED // «профиль подтверждён представителем школы»
}

model School {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  name               String
  cityId             String
  city               City                     @relation(fields: [cityId], references: [id])
  description        String?
  directions         String[] // направления: бачата, сальса, кизомба...
  levels             DanceLevel[] // какие уровни преподаются
  contactPhone       String?
  contactEmail       String?
  socialLinks        Json? // { instagram, telegram, vk, website }
  verificationStatus SchoolVerificationStatus @default(COMMUNITY)
  ownerUserId        String? // представитель-владелец после подтверждения заявки
  owner              User?                    @relation("SchoolOwner", fields: [ownerUserId], references: [id])
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  branches              SchoolBranch[]
  teachers              Teacher[]
  schedules             ClassSchedule[]
  events                Event[]
  reviews               Review[]
  eventTemplates        EventTemplate[]
  eventSeries           EventSeries[]
  festivalReferralCodes FestivalReferralCode[]
  faqItems              SchoolFaqItem[]

  @@index([cityId])
  @@index([verificationStatus])
  @@index([ownerUserId])
}

model SchoolFaqItem {
  // FAQ карточки школы — по образцу FestivalFaqItem (docs/00_DECISIONS.md,
  // Festival Engine Stage 2): ведёт владелец школы (School.ownerUserId),
  // показывается аккордеоном на публичной странице /schools/[slug].
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model SchoolBranch {
  // «Филиалы (адреса)» школы — вынесено отдельной таблицей, т.к. филиалов
  // может быть несколько на школу.
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  address   String
  cityId    String? // филиал может быть в другом городе, чем головная школа
  city      City?   @relation(fields: [cityId], references: [id])
  // Координаты — необязательные (2026-09-17, перенос публичной страницы
  // школы): пока владелец школы не проставил их через свой CRM (см.
  // src/server/schools/update-branches.ts), публичная страница просто
  // показывает адрес текстом без карты — координаты не подставляются
  // автоматически и не выдумываются на фронтенде.
  latitude  Float?
  longitude Float?

  @@index([schoolId])
  @@index([cityId])
}

model Teacher {
  id       String  @id @default(cuid())
  name     String
  photoUrl String?
  bio      String?
  schoolId String? // может быть без школы — приглашённый преподаватель
  school   School? @relation(fields: [schoolId], references: [id])
  isActive Boolean @default(true)

  schedules             ClassSchedule[]
  masterclassSessions   MasterclassSession[] // СЛОЙ Event Engine — переиспользуется как преподаватель мастер-класса, не дублируется отдельной сущностью
  festivalProgramItems  ProgramItem[] // Festival Engine — тот же принцип переиспользования, что и masterclassSessions выше
  festivalReferralCodes FestivalReferralCode[]

  @@index([schoolId])
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model ClassSchedule {
  // Регулярное расписание групп школы
  id        String     @id @default(cuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher?   @relation(fields: [teacherId], references: [id])
  weekday   Weekday
  startTime String // "19:00" — хранится строкой намеренно, без таймзон-логики на MVP
  endTime   String?
  level     DanceLevel
  hall      String? // зал / адрес занятия, если отличается от филиала

  @@index([schoolId])
  @@index([teacherId])
}

enum DanceLevel {
  BEGINNER
  ALL_LEVELS
  ADVANCED
}

// ---------------------------------------------------------------------------
// AccessRequest — заявка на выдачу проверенного доступа (организатор событий/
// фестиваля, руководитель школы, организатор соревнований). Заменяет собой
// прежний узкоспециализированный SchoolClaim (удалён — все данные были
// тестовыми, см. решение пользователя 2026-09-14) единой моделью на все 4
// вида доступа: одна заявка = один запрошенный тип, чтобы супер-админ мог
// одобрять/отклонять/отзывать каждый тип независимо, даже если поданы вместе
// в одной сессии визарда "Стать организатором" (/become-organizer).
// ---------------------------------------------------------------------------

enum AccessRequestType {
  EVENT_ORGANIZER
  FESTIVAL_ORGANIZER
  SCHOOL_HEAD
  COMPETITION_ORGANIZER
}

enum AccessRequestStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
  REVOKED
}

model AccessRequest {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation("AccessRequestApplicant", fields: [userId], references: [id])
  type   AccessRequestType

  // Общие поля анкеты (одинаковые для всех 4 типов).
  brandName   String // "Как вас представить" — название/бренд
  description String // краткое описание, до 500 символов (проверяется в zod-схеме)
  cityId      String?
  city        City?    @relation(fields: [cityId], references: [id])
  countryId   String?
  country     Country? @relation(fields: [countryId], references: [id])
  phone       String?
  links       Json // [{ type: "INSTAGRAM"|"FACEBOOK"|"WEBSITE"|"TELEGRAM"|"OTHER", url: string }]

  // Поля, специфичные для конкретного type (форма показывает только
  // relevant-подмножество) — см. src/server/access-requests/schemas.ts.
  payload Json

  status        AccessRequestStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?               @relation("AccessRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String? // причина reject/needs_info — видна заявителю

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type, status])
}

// ---------------------------------------------------------------------------
// EventSuggestion — §7 Events Engine ТЗ: обычный (не верифицированный)
// пользователь не может создать Event сам (canCreateEvents() гейтит это), но
// может ПРЕДЛОЖИТЬ идею события админу — лёгкая заявка-подсказка "я слышал
// про такое, посмотрите", не полноценный Event Wizard. НЕ путать с
// AccessRequest (это заявка на ПРАВО создавать события вообще, а не на
// конкретное событие) — они решают разные проблемы, см. docs/00_DECISIONS.md
// (там же зафиксировано, что более раннее предположение "AccessRequest уже
// закрывает §7" было ошибочным).
enum EventSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventSuggestion {
  id            String    @id @default(cuid())
  suggestedById String
  suggestedBy   User      @relation("EventSuggestionSubmitter", fields: [suggestedById], references: [id])
  title         String
  description   String
  cityId        String?
  city          City?     @relation(fields: [cityId], references: [id])
  // Предполагаемая дата — часто неизвестна точно тому, кто просто слышал про
  // событие, поэтому необязательна (в отличие от Event.startsAt, который
  // обязателен для настоящего Event).
  proposedDate  DateTime?
  // Ссылка-доказательство (пост в соцсети/сайт) — необязательна, но обычно
  // единственный способ админу быстро проверить, что это реально существует.
  link          String?

  status        EventSuggestionStatus @default(PENDING)
  reviewedById  String?
  reviewedBy    User?                 @relation("EventSuggestionReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String? // причина отказа — видна заявителю через уведомление

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([suggestedById])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Event — событие
// ---------------------------------------------------------------------------

enum EventFormat {
  PARTY // вечеринка
  MASTERCLASS // мастер-класс
  FESTIVAL // фестиваль
  CONTEST // конкурс
  INTENSIVE // воркшоп-интенсив
  // Events Engine (2026-09-15) — добавлены аддитивно (ALTER TYPE ... ADD
  // VALUE, тот же приём, что и A27), НЕ переименование существующих значений:
  // MASTERCLASS/CONTEST остаются как есть (используются 29 существующими
  // событиями + PartyDetails/MasterclassDetails/Competition.eventId), новые
  // форматы — самостоятельные значения без выделенной 1:1-таблицы деталей
  // (используют generic-конфигурацию реестра, как FESTIVAL/INTENSIVE).
  SOCIAL // соушл (танцевальный вечер без вечеринки-концепции)
  OPEN_AIR // open air
  PRACTICE // практика/тренировка
  OTHER // прочее
}

// event_type: зарезервированная точка расширения для СЛОЯ 3.
// Сегодня используется только как более грубая метка поверх EventFormat
// (обычное событие vs конкурс), чтобы в будущем event_type = CONTEST
// безболезненно подключался к сущностям Round/CallbackScore и т.д.
// Сами эти сущности слоя 3 в этом MVP НЕ реализуются.
enum EventType {
  REGULAR
  CONTEST
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Черновик Event Wizard'а vs модерация контента — два НЕЗАВИСИМЫХ понятия
// (см. обсуждение в чате про Event Engine): status — стадия жизненного цикла
// самого организатора (черновик/опубликовано/архив), moderationStatus —
// решение модератора сайта о публичной видимости. DRAFT никогда не попадает
// в очередь модерации и не виден никому, кроме автора. По умолчанию —
// PUBLISHED: все существующие на момент миграции события не являются
// черновиками, их видимость по-прежнему определяет только moderationStatus,
// как и раньше.
enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Events Engine (2026-09-15) — НЕЗАВИСИМАЯ ось от EventStatus (lifecycle) и
// moderationStatus (решение модератора): certainty отвечает только на вопрос
// "насколько точны дата/место", а не "виден ли Event и кому". Default —
// CONFIRMED: все существующие на момент миграции события трактуются как
// подтверждённые (что верно по факту — до этой задачи предварительных
// событий в системе не было).
enum EventCertainty {
  TENTATIVE // дата/место ещё уточняются — публично помечается как предварительное событие
  CONFIRMED
}

// "Способ доступа" — см. комментарий у Event.ticketingMode.
enum EventTicketingMode {
  UNSET
  FREE
  TICKETS
  PASSES
  TICKETS_AND_PASSES
}

model Event {
  id                  String             @id @default(cuid())
  slug                String             @unique
  title               String
  cityId              String
  city                City               @relation(fields: [cityId], references: [id])
  schoolId            String? // организатор — школа...
  school              School?            @relation(fields: [schoolId], references: [id])
  organizerName       String? // ...или свободный текст, если организатор без школы
  format              EventFormat
  eventType           EventType          @default(REGULAR) // СЛОЙ 3: точка расширения, см. комментарий выше
  level               DanceLevel
  startsAt            DateTime
  endsAt              DateTime?
  venueName           String
  venueAddress        String?
  latitude            Float? // Event Engine: необязательная геометка места проведения
  longitude           Float?
  capacity            Int? // Event Engine: вместимость площадки/события, необязательно
  registrationEnabled Boolean            @default(false) // Event Engine: показывать ли блок регистрации на публичной странице (сама регистрация по-прежнему может быть внешней ссылкой — externalLinkUrl, слой 2 ещё не подключен)
  description         String?
  // Обложка/афиша — с этой задачи ("загрузка афиши") ЭТО ПОЛЕ БОЛЬШЕ НЕ
  // ЗАПОЛНЯЕТСЯ ВРУЧНУЮ через Event Wizard: оно денормализованный кэш URL
  // текущей главной афиши (EventMedia.isMain = true у этого Event),
  // синхронизируется сервисом src/server/events/event-media-service.ts при
  // загрузке/удалении/смене главной. Читающий код (EventCard,
  // EventCardPreview, /events/[slug], sitemap, JSON-LD) не меняется вообще —
  // продолжает читать photoUrl как раньше, поэтому события, созданные ДО
  // этой задачи (прямая внешняя
  // ссылка, без единой строки EventImage), остаются рабочими без миграции
  // данных.
  photoUrl            String?
  priceText           String? // цена текстом ("15 BYN", "бесплатно", "по договорённости")
  externalLinkUrl     String? // ссылка на внешнюю регистрацию/билет — в слое 1 сайт сам не продаёт
  // "Способ доступа" (2026-09-16, Ticket Engine v2) — выбирается организатором
  // в мастере создания события, определяет, какие вкладки/шаги показывать
  // (Билеты/Pass/оба). ЧИСТО UI-подсказка, не хардограничение на уровне
  // сервера — организатор технически может завести и TicketType, и Pass
  // независимо от выбранного режима, ничего не блокируется искусственно.
  // UNSET — значение для всех событий, созданных ДО этой задачи (они не
  // делали этот выбор явно).
  ticketingMode       EventTicketingMode @default(UNSET)
  tags                String[]
  status              EventStatus        @default(PUBLISHED) // Event Engine: черновик мастера создания, см. комментарий у enum
  certainty           EventCertainty     @default(CONFIRMED) // Events Engine: см. комментарий у enum — независимая ось от status/moderationStatus
  moderationStatus    ModerationStatus   @default(PENDING)
  createdById         String
  createdBy           User               @relation("EventCreator", fields: [createdById], references: [id])
  moderatedById       String?
  moderatedBy         User?              @relation("EventModerator", fields: [moderatedById], references: [id])
  moderatedAt         DateTime?
  isArchived          Boolean            @default(false) // просроченные события уходят из ленты, но не удаляются
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Recurring Events (2026-09-16) — если это событие сгенерировано серией,
  // seriesId ссылается на неё, occurrenceDate — СТАБИЛЬНЫЙ календарный "слот"
  // серии на момент генерации (НЕ пересчитывается, если организатор потом
  // переопределил конкретные startsAt/endsAt для этого occurrence — см.
  // комментарий у EventSeries). Именно на occurrenceDate держится
  // идемпотентность генератора через unique-констрейнт ниже, а не на startsAt.
  // onDelete: SetNull — серии сегодня не удаляются физически (только
  // архивируются), но это defense-in-depth на случай будущего hard-delete.
  seriesId       String?
  series         EventSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  occurrenceDate DateTime?

  attendances   Attendance[]
  achievements  Achievement[]
  competition   Competition? // СЛОЙ 3: когда eventType = CONTEST, здесь — привязанное соревнование движка Jack & Jill (см. docs/00_DECISIONS.md, D3)
  registrations EventRegistration[] // Events Engine: регистрации на само событие (Party/Masterclass/...), НЕ то же самое, что Registration Competition Engine
  teamMembers   EventTeamMember[] // Events Engine, этап 5: совместное управление событием, см. комментарий у модели

  // Event Engine — type-specific конфигурация (расширяемый реестр типов,
  // см. src/lib/events/event-type-registry.ts). PARTY/MASTERCLASS хранят
  // свои детали здесь; COMPETITION использует уже существующий `competition`
  // выше — новых таблиц для него не заводим.
  partyDetails           PartyDetails?
  masterclassDetails     MasterclassDetails?
  // Festival Engine — обратная связь bridge-Event → Festival (Festival.eventId,
  // по образцу Competition.eventId, D3). Festival — САМОСТОЯТЕЛЬНАЯ сущность,
  // не деталь-таблица Event (в отличие от PartyDetails/MasterclassDetails
  // выше) — см. docs/FESTIVAL_ENGINE_ER.md. Это событие может быть bridge
  // максимум одного Festival (nullable, @unique на Festival.eventId).
  festival               Festival?
  priceOptions           EventPriceOption[]
  // Простые билеты на само это событие (2026-09-16) — см. комментарий у
  // TicketType. Независимо от passes ниже — событие может продавать и то, и
  // другое одновременно (см. Event.ticketingMode).
  ticketTypes            TicketType[]
  // СЛОЙ 2 — платный доступ к событию (см. комментарий у Pass ниже).
  passes                 Pass[]
  tickets                Ticket[]
  promoCodes             PromoCode[]
  media                  EventMedia[]
  // Commerce Engine v1 (см. комментарий у модели Product/Order) — обратные
  // связи для Product.event/Order.event.
  products               Product[]
  orders                 Order[]
  doorSales              DoorSale[]
  // Обратная связь для ProgramItem.linkedEvent ниже — отдельное
  // "настоящее" событие (party/workshop/contest) со своей публичной
  // страницей, на которое ссылается пункт программы фестиваля. Не путать с
  // festival выше — то событие ЯВЛЯЕТСЯ bridge фестиваля, это — событие, НА
  // КОТОРОЕ ссылается программа чужого фестиваля.
  linkedFromProgramItems ProgramItem[]       @relation("ProgramItemLinkedEvent")

  @@unique([seriesId, occurrenceDate]) // идемпотентность генератора — NULL/NULL (обычные разовые события) не конфликтуют между собой в Postgres
  @@index([cityId, startsAt])
  @@index([schoolId])
  @@index([moderationStatus])
  @@index([eventType])
  @@index([createdById])
  @@index([moderatedById])
  @@index([status])
  @@index([seriesId])
}

// Единая Media-сущность события (Event Media Gallery, задача от 2026-09-12) —
// сознательно ЗАМЕНИЛА собой более раннюю EventImage (та же миграционная
// сессия, в БД не было ни одной строки — переименование, не откат): у
// задачи есть явное требование "не хранить Event.coverImage и Event.images[]
// как две независимые системы одного файла" — единственный источник истины
// здесь, Event.photoUrl остаётся ДЕНОРМАЛИЗОВАННЫМ КЭШЕМ url текущей главной
// (isMain = true), синхронизируется сервисом (см. комментарий у поля).
// Ровно одна строка на Event может иметь isMain = true. type зарезервирован
// под будущие типы медиа (задача явно упоминает "future media types") —
// сегодня используется только IMAGE.
enum EventMediaType {
  IMAGE
}

model EventMedia {
  id             String         @id @default(cuid())
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type           EventMediaType @default(IMAGE)
  url            String
  storageKey     String // путь объекта в Supabase Storage (бакет "event-images", публичный на чтение) — отдельно от url, чтобы удалять/заменять без парсинга URL
  isMain         Boolean        @default(false)
  sortOrder      Int            @default(0)
  // mimeType/fileSize — параметры ФИНАЛЬНОГО (обработанного, сохранённого в
  // Storage) файла, сегодня всегда "image/webp" — сервер больше не хранит
  // оригинал (задача "Upload/Compression/Cache", 2026-09-12, §6). originalSize
  // — размер исходника ДО обработки, нужен только для оценки эффективности
  // сжатия (originalSize/fileSize) — сам коэффициент не хранится отдельным
  // полем, это производная величина, лишний источник рассинхронизации.
  mimeType       String
  fileSize       Int
  originalSize   Int            @default(0)
  width          Int?
  height         Int?
  originalName   String?
  // SHA-256 обработанного файла — дешёвая защита от случайной повторной
  // загрузки того же изображения в одно и то же событие (задача §20:
  // "не усложняй без необходимости" — один хэш-столбец, без отдельного
  // сервиса/очереди).
  contentHash    String?
  // "Position" из задачи (§11) — простой выбор стороны для CSS
  // object-position там, где карточка обрезает изображение под
  // object-fit: cover; полноценный визуальный crop-редактор сознательно не
  // реализован в этом проходе (задача сама называет его опциональным
  // "если не слишком сложно") — оригинальный файл в любом случае никогда не
  // изменяется необратимо.
  objectPosition String         @default("center")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([eventId])
  @@index([eventId, isMain])
  @@index([eventId, contentHash])
}

// Варианты цены/билета — общие для PARTY (Early Bird/Regular/At Door) и
// MASTERCLASS (Solo/Couple/Masterclass+Party), поэтому одна таблица на
// Event, а не отдельная под каждый тип (не дублируем структуру ради имени).
//
// LEGACY (2026-09-16, Ticket Engine v2): с появлением TicketType ниже эта
// модель больше НЕ пишется из мастера создания события для новых событий —
// оставлена как есть только чтобы старые события (созданные до этой задачи)
// продолжали отображать уже сохранённые варианты без миграции данных.
// Разница с TicketType принципиальная, не косметическая: EventPriceOption —
// чисто отображаемая строка ("Цена: 15 BYN" на публичной странице, без
// запасов/статуса/реальных продаж), TicketType — настоящий продаваемый
// продукт с инвентарём и историей выданных Ticket (см. комментарий у
// TicketType).
model EventPriceOption {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String
  price     Decimal? @db.Decimal(10, 2)
  currency  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([eventId])
}

// ---------------------------------------------------------------------------
// TicketType — простой билет на ОДНО конкретное событие (2026-09-16, по
// прямому запросу пользователя после разбора модели Ticket/Pass). Пример:
// "Bachata Friday Party" с вариантами Teacher/Dancer/School Partner/Early
// Bird — это четыре TicketType, НЕ Pass (Pass — отдельная сущность для
// доступа к НЕСКОЛЬКИМ событиям, см. комментарий у модели Pass ниже, она НЕ
// переименована и НЕ сужена этой задачей — TicketType существует РЯДОМ с
// ней, а не вместо).
//
// Осознанно проще Pass: без ценовых периодов (Early Bird — просто отдельный
// TicketType, не тир), без грантов доступа к программе (у одного события нет
// внутренней подпрограммы) и без шаблонов — если что-то из этого
// понадобится, это отдельная, осознанная доработка, а не то, что нужно
// "на всякий случай" сегодня (CLAUDE.md §14/§20 — не усложняй
// преждевременно).
model TicketType {
  id           String     @id @default(cuid())
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  // null — бесплатный билет.
  price        Decimal?   @db.Decimal(10, 2)
  currency     String?
  quantity     Int? // null — без ограничения мест
  soldQuantity Int        @default(0)
  salesStartAt DateTime?
  salesEndAt   DateTime?
  // Переиспользуем PassStatus — тот же жизненный цикл (DRAFT/ACTIVE/PAUSED/
  // SOLD_OUT/ENDED/ARCHIVED), тот же принцип "SOLD_OUT/ENDED — только
  // сервер", заводить копию enum ради другого имени модели избыточно.
  status       PassStatus @default(DRAFT)
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tickets Ticket[]
  // Commerce Engine v1 — обратная связь для Product.ticketType.
  product Product?

  @@index([eventId])
  @@index([eventId, status])
}

// ---------------------------------------------------------------------------
// Pass — СЛОЙ 2, предложение организатора о платном/бесплатном доступе к
// событию (2026-09-16). Pass ≠ конкретный билет пользователя: Pass
// описывает ПРЕДЛОЖЕНИЕ ("Full Pass, 120 BYN, 50 мест"), а Ticket —
// уже выданный/купленный конкретным человеком экземпляр.
//
// НЕ дублирует EventPriceOption выше — та модель ЧИСТО отображаемая строка
// ("Цена: 15 BYN" на публичной странице, без запасов/статуса/продаж) и
// продолжает использоваться как есть. Pass — отдельная, более тяжёлая
// сущность с жизненным циклом и лимитом мест, две модели сосуществуют
// (EventPriceOption никуда не делась, ничего в ней не меняется).
//
// Расширение архитектуры (2026-09-16, по прямому запросу пользователя,
// "заложить архитектуру сразу, даже если UI первого релиза уже её не
// использует полностью"):
// - PassPriceTier — несколько ценовых периодов (Early Bird/Regular/Late) с
//   собственным окном действия; Pass.price/currency остаются "базовой"
//   ценой (используется, если ни один тир не активен на текущий момент).
// - PassAccessGrant — к каким конкретным пунктам программы (ProgramItem
//   фестиваля) или сессиям мастер-класса (MasterclassSession) даёт доступ
//   этот Pass. Пустой список = доступ ко ВСЕМУ (Full Pass не обязан
//   перечислять каждый пункт программы вручную) — ограничение начинается
//   только когда появляется хотя бы одна запись.
// - PromoCode/PromoCodePass — коды скидок, привязанные к событию и
//   опционально к конкретным Pass (пусто = применим к любому Pass события).
//   Сама механика расчёта скидки при выдаче билета — сознательно ВНЕ рамок
//   этой правки (прямые слова пользователя: "не обязательно делать прямо
//   сейчас"), заведена только схема + Ticket.promoCodeId/discountAmount для
//   аудита, когда механика появится.
// - Pass.imageUrl/allowMultipleEntry — обложка предложения и будущее правило
//   повторного входа (сама проверка на входе — часть будущего QR-check-in,
//   ещё не реализована, см. исходный комментарий про "минимально
//   необходимая модель").
enum PassType {
  FULL_PASS
  PARTY_PASS
  WORKSHOP_PASS
  DAY_PASS
  COMPETITION_PASS
  VIP_PASS
  FREE_PASS
  CUSTOM
}

enum PassStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  ENDED
  ARCHIVED
}

// Условия возврата (2026-09-17, план docs/FESTIVAL_UI_TO_DB_PLAN.md) — только
// ПОЛИТИКА ("можно ли и на каких условиях"), показывается покупателю на
// публичной странице до оплаты. Сам факт возврата — Ticket.status=REFUNDED
// (уже существовал), это разные оси: политика не гарантирует, что кто-то
// когда-либо ею воспользуется, а REFUNDED не говорит, было ли это разрешено
// правилами Pass (проверка правила — сервисный слой, не в этой миграции).
enum PassRefundPolicy {
  NONE // без возврата
  UNTIL_DATE // возврат разрешён до refundDeadline
  PARTIAL // возврат с удержанием комиссии refundFeePercent
  FULL // полный возврат в любой момент
}

model Pass {
  id                 String           @id @default(cuid())
  eventId            String
  event              Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  type               PassType
  // null — цена ещё не назначена организатором либо type = FREE_PASS.
  price              Decimal?         @db.Decimal(10, 2)
  currency           String? // свободный текст, как EventPriceOption.currency ("BYN", "EUR", ...)
  quantity           Int? // null — без ограничения мест
  // Пишется только будущим Ticket-сервисом при продаже/выдаче билета —
  // сегодня ни один код это поле не меняет, стартует с 0.
  soldQuantity       Int              @default(0)
  salesStartAt       DateTime?
  salesEndAt         DateTime?
  validFrom          DateTime?
  validUntil         DateTime?
  status             PassStatus       @default(DRAFT)
  sortOrder          Int              @default(0)
  isActive           Boolean          @default(true)
  // Обложка предложения (публичная страница/попап покупки) — обычная
  // ссылка, как Event.photoUrl, без отдельной галереи (Pass — не Event,
  // одно изображение достаточно).
  imageUrl           String?
  // Будущий door check-in (Ticket пока не имеет полей check-in вообще —
  // см. комментарий у Ticket) — Full Pass обычно можно проходить много раз
  // за фестиваль, Party Pass на конкретный вечер — как правило один раз.
  // Поле заведено заранее, реальная проверка появится вместе с check-in.
  allowMultipleEntry Boolean          @default(true)
  // Условия возврата (2026-09-17) — см. комментарий у enum PassRefundPolicy.
  refundPolicy       PassRefundPolicy @default(NONE)
  refundDeadline     DateTime?
  refundFeePercent   Decimal?         @db.Decimal(5, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tickets         Ticket[]
  priceTiers      PassPriceTier[]
  accessGrants    PassAccessGrant[]
  promoCodePasses PromoCodePass[]
  // Commerce Engine v1 — обратные связи для Product.pass/UserPass.pass.
  product         Product?
  userPasses      UserPass[]

  @@index([eventId])
  @@index([eventId, status])
}

// Шаблон Pass (2026-09-16, по прямому запросу пользователя) — "полностью
// заведённый Pass, сохранённый как шаблон": организатор один раз настраивает
// типовой набор полей ("Full Pass", 120 BYN, обложка, разрешён повторный
// вход) и переиспользует его при создании Pass на РАЗНЫХ событиях — не
// перезабивая всё заново каждый раз. НЕ копирует даты (salesStartAt/
// salesEndAt/validFrom/validUntil) — они всегда свои у каждого события,
// шаблон хранит только содержательные поля. НЕ копирует quantity/inventory
// динамику (soldQuantity, status) — это состояние конкретного Pass, не
// шаблона. Владелец — конкретный User (createdById), как и Event —
// шаблоны организатора видны только ему самому (+ ADMIN), общих шаблонов
// между организаторами нет (не запрошено, не усложняем).
model PassTemplate {
  id                 String   @id @default(cuid())
  createdById        String
  createdBy          User     @relation("PassTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  name               String
  description        String?
  type               PassType
  price              Decimal? @db.Decimal(10, 2)
  currency           String?
  quantity           Int?
  imageUrl           String?
  allowMultipleEntry Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([createdById])
}

// Ценовые периоды (Early Bird/Regular/Late) — Pass.price/currency остаются
// "базовой" ценой на случай, если ни один период не активен на текущий
// момент (например, ещё не создан ни один тир — обратная совместимость с
// уже существующими Pass). getCurrentPassPrice() в pass-service.ts находит
// тир, чьё [validFrom, validUntil) содержит "сейчас" (последний подходящий
// по sortOrder, если пересеклись) — валидация непересечения окон одного
// Pass делается в сервисе при создании/редактировании тира, не на уровне БД.
model PassPriceTier {
  id         String    @id @default(cuid())
  passId     String
  pass       Pass      @relation(fields: [passId], references: [id], onDelete: Cascade)
  label      String // "Early Bird", "Regular", "Late"
  price      Decimal   @db.Decimal(10, 2)
  currency   String?
  validFrom  DateTime? // null — действует с самого начала продаж
  validUntil DateTime? // null — действует до конца продаж (или до начала следующего тира)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Commerce Engine v1 — обратная связь для OrderItem.passPriceTier.
  orderItems OrderItem[]

  @@index([passId])
}

// К каким конкретным пунктам программы фестиваля/сессиям мастер-класса даёт
// доступ этот Pass. У строки заполнено РОВНО ОДНО из двух полей (проверяется
// в сервисе + CHECK-constraint на уровне БД, см. migration.sql — Prisma DSL
// не поддерживает декларативный CHECK). ПУСТОЙ список грантов у Pass = без
// ограничений (доступ ко всему) — именно так проще всего смоделировать
// "Full Pass", не перечисляя вручную каждый текущий и будущий пункт
// программы.
model PassAccessGrant {
  id                   String              @id @default(cuid())
  passId               String
  pass                 Pass                @relation(fields: [passId], references: [id], onDelete: Cascade)
  programItemId        String?
  programItem          ProgramItem?        @relation(fields: [programItemId], references: [id], onDelete: Cascade)
  masterclassSessionId String?
  masterclassSession   MasterclassSession? @relation(fields: [masterclassSessionId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())

  @@unique([passId, programItemId])
  @@unique([passId, masterclassSessionId])
  @@index([passId])
  @@index([programItemId])
  @@index([masterclassSessionId])
}

// Промокоды (2026-09-16) — привязаны к событию, опционально сужены до
// конкретных Pass через PromoCodePass (пусто = применим к любому Pass этого
// события). Сама механика применения скидки при выдаче билета сознательно
// НЕ реализована в этой правке (прямые слова пользователя — "не обязательно
// делать прямо сейчас"), только схема + Ticket.promoCodeId/discountAmount
// для будущего аудита применённых скидок.
enum PromoDiscountType {
  PERCENT
  FIXED_AMOUNT
}

model PromoCode {
  id            String            @id @default(cuid())
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code          String
  discountType  PromoDiscountType
  discountValue Decimal           @db.Decimal(10, 2) // 20 (=20%) или 50 (=50 BYN), в зависимости от discountType
  validFrom     DateTime?
  validUntil    DateTime?
  maxUses       Int? // null — без ограничения
  usedCount     Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  passes  PromoCodePass[]
  tickets Ticket[]
  // Commerce Engine v1 — обратная связь для Order.promoCode.
  orders  Order[]

  @@unique([eventId, code])
  @@index([eventId])
}

model PromoCodePass {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  passId      String
  pass        Pass      @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, passId])
  @@index([passId])
}

// ---------------------------------------------------------------------------
// Ticket — УНИВЕРСАЛЬНЫЙ билет доступа на событие (2026-09-16, по прямому
// решению пользователя после обсуждения). Схема одна: 1 Ticket = 1 оплата,
// вне зависимости от того, есть ли у события Pass:
//
// - Событие БЕЗ Pass (обычная вечеринка без тиров доступа) — заводится ОДИН
//   passless Ticket (passId = null) на пару (event, dancer). Это прямая
//   замена старому EventRegistration.isPaid/paidAt (удалены отсюда —
//   перенесены в такие passless Ticket одноразовой миграцией
//   20260916060000_ticket_universal_payment): "нет тикета или тикет есть, но
//   isPaid=false" — значит не оплачено, ленивое создание (тикет заводится
//   только когда организатор первый раз отмечает оплату, не заранее при
//   регистрации).
// - Событие С Pass — один Ticket на каждый купленный Pass (танцор может
//   держать несколько Ticket на одно событие, если купил несколько РАЗНЫХ
//   Pass — см. @@unique([dancerId, passId]) ниже, работает только когда
//   passId not null, потому что PostgreSQL не считает два NULL равными).
// - Событие С TicketType (2026-09-16, Ticket Engine v2, см. комментарий у
//   TicketType) — ровно та же схема, что у Pass выше, но для простого
//   единичного билета: один Ticket на каждый купленный TicketType
//   (@@unique([dancerId, ticketTypeId]), та же логика NULL-исключения).
//   Ticket.passId и Ticket.ticketTypeId ВЗАИМОИСКЛЮЧАЮЩИ (проверяется и в
//   ticket-service.ts, и CHECK-constraint'ом на уровне БД, см.
//   migration.sql) — билет либо про Pass, либо про TicketType, либо ни про
//   что (passless/typeless fallback для события без обоих каталогов).
//   Уникальность "один полностью пустой (без Pass и без TicketType) Ticket
//   на танцора на событие" обеспечена частичным индексом
//   Ticket_dancerId_eventId_no_product_key (WHERE passId IS NULL AND
//   ticketTypeId IS NULL, см. migration.sql) + advisory-lock в
//   ticket-service.ts.
// - Событие С Pass, но БЕЗ собственного билета (2026-09-16, этап 3
//   "межсобытийный Pass фестиваля") — если это событие является дочерним
//   (ProgramItem.linkedEvent) для фестиваля, на котором танцор держит
//   действующий Pass с доступом к этому пункту программы, вход
//   материализуется отдельным "производным" Ticket с eventId = ЭТО дочернее
//   событие, passId = Pass фестиваля, price = null (деньги уже получены при
//   покупке Pass на событии фестиваля, повторно не списываются — так
//   Revenue не задваивается, см. resolveFestivalPassEntry() в
//   ticket-service.ts). Второй, обычный Ticket фестиваля-родителя со своей
//   ненулевой ценой остаётся как есть — Attendance (сколько раз Pass
//   реально использовали) и Revenue (сколько денег реально получено за сам
//   Pass) в итоге считаются раздельно, просто фильтром по price IS NOT NULL.
//
// EventRegistration.status (сама явка/лист ожидания/check-in) НЕ затронута —
// это отдельная, независимая ось, которая осталась как была.
//
// Ticket Engine + Payment (isPaid/paidAt) — простой штампик, тот же принцип,
// что и в остальном проекте ("используй существующую Payment-систему, не
// создавай новую платёжную архитектуру"). Сегодня оплата отмечается
// organizer/ADMIN вручную (наличные/перевод вне системы). Архитектура
// открыта под будущее онлайн-эквайринг (ЕРИП/bePaid, см. шапку файла) и под
// будущую роль "дистрибьютор" (человек, назначенный организатором, продаёт
// билеты и сообщает организатору — тот вручную подтверждает): оба будущих
// сценария просто вызовут ту же функцию отметки оплаты, что и ручная кнопка
// в админке сегодня — новых полей под них заранее не заводим.
enum TicketStatus {
  ISSUED // выдан/куплен, действителен
  CANCELLED // отменён (танцором или организатором) — история не удаляется
  REFUNDED // оформлен возврат денег
}

model Ticket {
  id           String      @id @default(cuid())
  eventId      String
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  passId       String? // null — билет без Pass (см. комментарий у модели выше)
  pass         Pass?       @relation(fields: [passId], references: [id])
  // Простой билет одного события (2026-09-16) — взаимоисключающе с passId,
  // см. комментарий у модели выше.
  ticketTypeId String?
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])
  dancerId     String
  dancer       Dancer      @relation(fields: [dancerId], references: [id])

  status   TicketStatus @default(ISSUED)
  // Снимок цены/валюты НА МОМЕНТ выдачи — не пересчитывается задним числом
  // при изменении Pass.price (тот же принцип неизменности исторических
  // данных, что и у Result/Points в Competition Engine, CLAUDE.md §39/§51).
  // Для passless Ticket остаётся null — там нет фиксированной цены Pass.
  price    Decimal?     @db.Decimal(10, 2)
  currency String?

  // Бесплатный Pass (price = null/0) выдаётся сразу с isPaid=true — не
  // должен выглядеть как "висящий долг" и не требует отдельного шага оплаты
  // (прямое требование ТЗ: "бесплатный билет не создаёт ошибочный payment").
  isPaid Boolean   @default(false)
  paidAt DateTime?

  // Кто выдал билет — организатор/член команды события, которому танцор
  // отдал деньги лично (тот же принцип атрибуции, что и
  // EventRegistration.checkedInById).
  issuedById String?
  issuedBy   User?   @relation("TicketIssuedBy", fields: [issuedById], references: [id])

  // Промокод, применённый к этому билету — только для аудита (2026-09-16),
  // сама механика расчёта скидки ещё не реализована (см. комментарий у
  // PromoCode). discountAmount — снимок суммы скидки на момент выдачи, той
  // же природы, что и price/currency выше.
  promoCodeId    String?
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])
  discountAmount Decimal?   @db.Decimal(10, 2)

  // Реферальный код артиста/школы (2026-09-17, план
  // docs/FESTIVAL_UI_TO_DB_PLAN.md) — та же природа снимка, что и у
  // promoCodeId/discountAmount выше: referralDiscountAmount/
  // referralCommissionAmount фиксируют суммы НА МОМЕНТ выдачи, не
  // пересчитываются задним числом при изменении FestivalReferralCode.
  referralCodeId           String?
  referralCode             FestivalReferralCode? @relation(fields: [referralCodeId], references: [id])
  referralDiscountAmount   Decimal?              @db.Decimal(10, 2)
  referralCommissionAmount Decimal?              @db.Decimal(10, 2)

  issuedAt    DateTime  @default(now())
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ВАЖНО: уникальность Pass включает eventId, а не только (dancerId,
  // passId) — с появлением межсобытийного Pass фестиваля (этап 3, см.
  // комментарий про "производный" Ticket выше) один и тот же Pass законно
  // порождает НЕСКОЛЬКО Ticket у одного танцора: один на событии самого
  // фестиваля (реальная покупка) и по одному на каждом дочернем событии, где
  // Pass был предъявлен (производные, price = null). Без eventId в ключе
  // второй INSERT падал бы как "дубликат" из-за этого же уникального
  // индекса. TicketType, в отличие от Pass, всегда однособытийный — там
  // eventId в ключе не нужен, (dancerId, ticketTypeId) достаточно.
  //
  // Работает только для passId/ticketTypeId NOT NULL (PostgreSQL не считает
  // два NULL равными — уникальность полностью пустого (без Pass и без
  // TicketType) билета обеспечена ОТДЕЛЬНЫМ частичным индексом
  // Ticket_dancerId_eventId_no_product_key, см. migration.sql, его здесь нет
  // — Prisma DSL не поддерживает partial unique index. CHECK-constraint
  // "не оба одновременно" — тоже только в migration.sql, той же причине.)
  //
  // ВАЖНО (2026-09-18, исправление бага "не могу выдать билет повторно после
  // возврата"): все три уникальных индекса Ticket (эти два ниже —
  // Ticket_dancerId_passId_eventId_key/Ticket_dancerId_ticketTypeId_key — и
  // no_product_key выше) теперь PARTIAL, с условием WHERE status = 'ISSUED'
  // (см. migration.sql, 20260918010000_ticket_reissue_after_refund). Раньше
  // они были безусловными и считали дубликатом любую пару
  // (dancerId, passId/ticketTypeId, eventId), даже когда старая запись уже
  // CANCELLED/REFUNDED — из-за этого refundTicket() освобождал место
  // допуска (assertSingleAdmissionPerEvent видит только status='ISSUED'), но
  // повторная выдача того же Pass/TicketType падала в P2002 раньше, чем
  // вообще доходило до этой проверки. Именно поэтому @@unique ниже
  // ЗАКОММЕНТИРОВАНЫ, а не активны — Prisma DSL не поддерживает partial
  // unique index, а объявленный здесь как обычный @@unique уводил бы
  // реальную БД в рассинхронизацию при следующем migrate diff.
  // ---------------------------------------------------------------------------
  // Commerce Engine v1 (2026-09-17) — Phase 1, ТОЛЬКО схема, аддитивно.
  // orderItemId/userPassId — новые, необязательные связи с Order/OrderItem/
  // UserPass ниже (см. комментарий у Product/Order/OrderItem/UserPass). Пока
  // NULLABLE и НЕ backfill'ены (Phase 2, отдельный шаг) — существующий код
  // (ticket-service.ts) продолжает писать passId/ticketTypeId/price/isPaid
  // напрямую как раньше, ничего не сломано. После того как сервисный слой
  // перейдёт на createOrder()/fulfillOrder() (Phase 3-4), passId/ticketTypeId/
  // price/currency/isPaid/paidAt/promoCodeId/discountAmount/referralCode* здесь
  // станут избыточны (их роль переходит к OrderItem/Payment/UserPass) и будут
  // удалены отдельным cleanup-шагом (Phase 9) — не раньше, чем весь читающий
  // их код будет переведён (CLAUDE.md §16/§51: не удалять то, на что ещё
  // ссылаются).
  orderItemId String?
  orderItem   OrderItem?     @relation(fields: [orderItemId], references: [id])
  userPassId  String?
  userPass    UserPass?      @relation(fields: [userPassId], references: [id])
  checkIn     TicketCheckIn?

  // @@unique([dancerId, passId, eventId]) и @@unique([dancerId, ticketTypeId])
  // ЗАКОММЕНТИРОВАНЫ (2026-09-18) — в реальной БД это теперь partial unique
  // index (WHERE status = 'ISSUED', см. комментарий выше и migration.sql
  // 20260918010000_ticket_reissue_after_refund), которые Prisma DSL выразить
  // не может. Оставлять их активными здесь означало бы, что следующий
  // `prisma migrate dev`/`db push` попытается "исправить" реальную БД,
  // заменив partial index на обычный — тем самым вернув баг "нельзя выдать
  // билет повторно после возврата".
  @@index([eventId])
  @@index([eventId, dancerId])
  @@index([passId])
  @@index([ticketTypeId])
  @@index([dancerId])
  @@index([passId, status])
  @@index([ticketTypeId, status])
  @@index([referralCodeId])
  @@index([orderItemId])
  @@index([userPassId])
}

// ---------------------------------------------------------------------------
// Commerce Engine v1 (2026-09-17, Phase 1 — только схема, см. docs/00_DECISIONS.md
// решение по итогам аудита Ticket/Pass/Commerce). Три развилки, подтверждённые
// пользователем перед этой миграцией:
// 1. Product — ТОНКАЯ обёртка над уже существующими Pass/TicketType (НЕ слияние
//    их в одну таблицу — вчерашнее решение D10 "TicketType и Pass — разные
//    сущности" НЕ отменяется). У Product НЕТ ни одного коммерческого поля
//    (ни price, ни quantity) — это чистый идентификатор "что именно продаётся",
//    цена/остаток мест остаются ЕДИНСТВЕННО в Pass(+PassPriceTier)/TicketType,
//    как и раньше. Без этого через полгода Product.price и TicketType.price
//    неизбежно разъехались бы.
// 2. Payment.provider — сегодня ТОЛЬКО MANUAL (организатор вручную подтверждает
//    получение денег, как и сейчас через Ticket.isPaid). Реальный онлайн-
//    эквайринг — отдельная, ещё не начатая задача (см. docs/audit_report.md
//    §8, PAY-001) с отдельным выбором провайдера/юрисдикции; вебхуки/их
//    идемпотентность здесь не реализуются, пока провайдера нет.
// 3. Self-checkout (танцор сам покупает и платит онлайн, корзина из нескольких
//    продуктов) — НЕ в этом заходе. Order/OrderItem/Payment/Refund формализуют
//    СУЩЕСТВУЮЩИЙ процесс (организатор вручную регистрирует продажу и
//    получение денег) в правильную структуру, а не добавляют новый публичный
//    UI покупки.
// Дополнительно (прямое требование пользователя при ревью этого плана):
// - OrderItem.passPriceTierId — снимок, какой именно ценовой тир Pass
//   (Early Bird/Regular/Late) действовал в момент покупки — отдельно от самой
//   суммы (unitPriceSnapshot), которая не пересчитывается, если тир потом
//   изменят/удалят.
// - Order.dancerId — ОДИН человек одновременно и платит, и получает доступ
//   (по прямому решению пользователя: покупка для других людей в рамках
//   одного заказа сознательно НЕ реализуется сейчас — "пока только себе
//   можно покупать", как и сегодня работает issueTicket()). Ticket.dancerId/
//   UserPass.dancerId при fulfillment всегда равны Order.dancerId.
// ---------------------------------------------------------------------------

enum ProductType {
  PASS
  EVENT_TICKET
}

// Идентификатор "что продаётся" для Order/OrderItem — ровно одно из
// passId/ticketTypeId заполнено (CHECK-constraint в migration.sql, Prisma DSL
// не поддерживает декларативный CHECK, тот же приём, что и у PassAccessGrant).
// НЕ хранит price/currency/quantity/soldQuantity — единственный источник
// этих значений остаётся Pass(+PassPriceTier)/TicketType, как и сегодня.
model Product {
  id           String      @id @default(cuid())
  eventId      String
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type         ProductType
  passId       String?     @unique
  pass         Pass?       @relation(fields: [passId], references: [id], onDelete: Cascade)
  ticketTypeId String?     @unique
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  orderItems OrderItem[]
  doorSales  DoorSale[]

  @@index([eventId])
  @@index([eventId, type])
}

enum OrderStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

// Заказ — что купили и для кого (dancerId), сколько (subtotal/discount/
// total). НЕ то же самое, что Payment (факт перевода денег) и НЕ то же самое,
// что Ticket/UserPass (сам факт выданного доступа — см. комментарий у
// OrderItem/Ticket.dancerId выше). eventId — Order создаётся в контексте
// ОДНОГО события (как и сегодня Pass/TicketType); "корзина" из товаров разных
// событий одного фестиваля — вне рамок self-checkout, см. решение 3 выше.
//
// dancerId — ОДИН И ТОТ ЖЕ человек одновременно и платит, и получает доступ
// (по прямому решению пользователя, 2026-09-17: "покупка для друзей" —
// другой человек-получатель на каждый Ticket/UserPass в рамках одного заказа —
// сознательно НЕ реализуется в этом заходе, только "купил сам себе", как и
// сегодня работает issueTicket()). Ticket.dancerId/UserPass.dancerId при
// fulfillment всегда равны Order.dancerId — отдельного "получателя" на уровне
// OrderItem/quantity в этой версии нет.
model Order {
  id             String                @id @default(cuid())
  eventId        String
  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dancerId       String
  dancer         Dancer                @relation(fields: [dancerId], references: [id])
  status         OrderStatus           @default(PENDING)
  currency       String?
  subtotal       Decimal               @default(0) @db.Decimal(10, 2)
  discount       Decimal               @default(0) @db.Decimal(10, 2)
  total          Decimal               @default(0) @db.Decimal(10, 2)
  promoCodeId    String?
  promoCode      PromoCode?            @relation(fields: [promoCodeId], references: [id])
  referralCodeId String?
  referralCode   FestivalReferralCode? @relation(fields: [referralCodeId], references: [id])
  // Кто провёл продажу в системе (организатор/член команды) — тот же смысл,
  // что и Ticket.issuedById сегодня.
  createdById    String
  createdBy      User                  @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]

  @@index([eventId])
  @@index([dancerId])
  @@index([eventId, status])
}

// Строка заказа — снимок цены/названия НА МОМЕНТ покупки (не пересчитывается
// задним числом при изменении Product/Pass/TicketType, тот же принцип
// неизменности истории, что уже применяется к Result/Points в Competition
// Engine). quantity > 1 — несколько единиц одного Product в одной строке;
// все выданные единицы (Ticket.dancerId/UserPass.dancerId) принадлежат ТОМУ
// ЖЕ человеку, что и Order.dancerId (см. комментарий у Order — покупка для
// других людей сейчас не реализуется).
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Только для productId → Pass с ценовыми тирами — какой именно тир
  // действовал в момент покупки (см. решение 4 выше). НЕ влияет на расчёт
  // (unitPriceSnapshot уже содержит итоговую сумму) — чисто для аудита/показа
  // "купил по Early Bird".
  passPriceTierId String?
  passPriceTier   PassPriceTier? @relation(fields: [passPriceTierId], references: [id])

  nameSnapshot      String
  unitPriceSnapshot Decimal? @db.Decimal(10, 2) // null — бесплатный Product
  currencySnapshot  String?
  quantity          Int      @default(1)
  discountAmount    Decimal? @db.Decimal(10, 2)
  total             Decimal  @default(0) @db.Decimal(10, 2)
  createdAt         DateTime @default(now())

  tickets    Ticket[]
  userPasses UserPass[]

  @@index([orderId])
  @@index([productId])
  @@index([passPriceTierId])
}

enum PaymentProvider {
  MANUAL
}

enum PaymentMethod {
  CASH // наличные
  TRANSFER // безналичный перевод (карта/счёт)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// Факт движения денег по Order — сегодня ВСЕГДА provider=MANUAL (см. решение
// 2 выше). providerPaymentId — задел под будущий реальный эквайринг, сегодня
// не используется. Один Order может иметь НЕСКОЛЬКО Payment (частичная
// предоплата в будущем) — намеренно не Order.paymentId.
model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider          PaymentProvider @default(MANUAL)
  providerPaymentId String?         @unique
  amount            Decimal         @db.Decimal(10, 2)
  currency          String?
  status            PaymentStatus   @default(PENDING)
  // Способ расчёта (2026-09-18, по прямому запросу пользователя) — только для
  // provider=MANUAL: как именно организатор получил деньги, наличными на
  // руки или переводом на карту/счёт. Nullable — старые Payment (до этой
  // миграции) метод не указывали, это НЕ "неизвестный наличные", а
  // буквально "не зафиксировано", UI должен показывать эти два случая
  // по-разному, не подставлять произвольное значение задним числом
  // (CLAUDE.md §51 — не переписываем историю).
  method            PaymentMethod?
  paidAt            DateTime?
  failureReason     String?

  // Кто отметил оплату (организатор/член команды) — при provider=MANUAL это
  // обязательный человек-подтверждающий; для будущего онлайн-провайдера этот
  // же принцип не подходит (вебхук не от лица пользователя) — тогда поле
  // станет nullable отдельной миграцией, не сейчас.
  recordedById String
  recordedBy   User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refunds Refund[]

  @@index([orderId])
  @@index([orderId, status])
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// Один Payment может иметь НЕСКОЛЬКО Refund (частичный возврат нескольких
// позиций заказа по отдельности) — см. Scenario 4 задачи. status=COMPLETED
// сразу при создании для MANUAL-провайдера (организатор возвращает деньги сам,
// вне системы, и фиксирует это одним действием) — PENDING/FAILED зарезервированы
// под будущий реальный эквайринг.
model Refund {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])

  amount   Decimal      @db.Decimal(10, 2)
  currency String?
  reason   String
  status   RefundStatus @default(COMPLETED)

  recordedById String
  recordedBy   User      @relation("RefundRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([paymentId])
  @@index([orderId])
}

// "Продажа на входе" (2026-09-18, по прямому запросу пользователя) —
// анонимный приём оплаты за Pass/TicketType от человека без аккаунта на
// сайте (иностранец, случайный гость и т.п.), когда организатору важен
// только общий оборот, а не то, кто именно это был. НАМЕРЕННО отдельная,
// самодостаточная модель — не переиспользует Order/Payment/Ticket:
// - Order.dancerId/Ticket.dancerId обязательны (NOT NULL) и завязаны на
//   Dancer, у которого обязателен свой User (@unique userId) — создавать
//   "танцора" без реального человека означало бы заводить мусорные
//   User/Dancer записи только ради бухгалтерии.
// - Ticket дополнительно подчиняется assertSingleAdmissionPerEvent (см.
//   ticket-service.ts) — "максимум один билет допуска на танцора на
//   событие"; один общий "фейковый" танцор на всех анонимных гостей упёрся
//   бы в это правило уже на второй продаже.
// Доступна для ЛЮБОГО события без отдельного переключателя — пользоваться
// или нет, решает сам организатор в моменте (кнопка "Продажа на входе" на
// вкладке "Заказы").
// Не участвует в "Участниках" (не создаёт EventRegistration) и не занимает
// capacity самого события, но ЗАНИМАЕТ инвентарь конкретного Pass/TicketType
// (soldQuantity), как и обычный Ticket — иначе лимит "мест" по этому
// продукту молча бы нарушался анонимными продажами.
model DoorSale {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Снимок названия/цены НА МОМЕНТ продажи — тот же принцип неизменности
  // истории, что и у OrderItem.nameSnapshot/unitPriceSnapshot.
  nameSnapshot String
  amount       Decimal       @db.Decimal(10, 2)
  currency     String?
  method       PaymentMethod
  // Необязательная заметка организатора ("иностранец", "друг DJ") — чисто
  // для памяти, ни на что не влияет.
  note String?

  recordedById String
  recordedBy   User     @relation("DoorSaleRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([eventId])
  @@index([productId])
}

enum UserPassStatus {
  ACTIVE
  REVOKED
}

// Конкретное право конкретного танцора на конкретный Pass — Pass остаётся
// "предложением" (определением), UserPass — тем, что реально получил ОДИН
// человек после оплаты. orderItemId nullable: производные/подарочные UserPass
// без отдельной покупки (будущее расширение) технически возможны, сегодня
// сервисный слой всегда создаёт вместе с OrderItem.
model UserPass {
  id          String         @id @default(cuid())
  dancerId    String
  dancer      Dancer         @relation(fields: [dancerId], references: [id])
  passId      String
  pass        Pass           @relation(fields: [passId], references: [id])
  orderItemId String?
  orderItem   OrderItem?     @relation(fields: [orderItemId], references: [id])
  status      UserPassStatus @default(ACTIVE)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Входы, материализованные по этому Pass — прямой (на событии, где Pass
  // куплен) и производные (на дочерних событиях фестиваля, см. комментарий
  // у Ticket выше про issueFestivalPassEntry).
  tickets Ticket[]

  @@unique([dancerId, passId])
  @@index([passId])
}

enum CheckInMethod {
  QR
  MANUAL
  ADMIN
}

// Факт явки ПО КОНКРЕТНОМУ Ticket — отдельно от EventRegistration.checkedInAt
// (явка на само событие вообще, другой домен) и от Competition Engine CheckIn
// (JNJ, модель с ТАКИМ ЖЕ именем уже существует ниже для другого домена —
// поэтому здесь TicketCheckIn, а не CheckIn, во избежание конфликта имён).
// Один Ticket — максимум один TicketCheckIn (allowMultipleEntry Pass с
// несколькими проходами — будущее расширение, сегодня не реализуется, см.
// комментарий у Pass.allowMultipleEntry).
model TicketCheckIn {
  id            String        @id @default(cuid())
  ticketId      String        @unique
  ticket        Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  checkedInAt   DateTime      @default(now())
  checkedInById String
  checkedInBy   User          @relation("TicketCheckedInBy", fields: [checkedInById], references: [id])
  method        CheckInMethod @default(MANUAL)
  createdAt     DateTime      @default(now())
}

// 1:1 к Event — заполняется только когда Event.format = PARTY.
model PartyDetails {
  id            String   @id @default(cuid())
  eventId       String   @unique
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  musicStyles   String[]
  djs           String[]
  danceFloors   String[]
  artists       String[]
  dressCode     String?
  photographer  String?
  foodAndDrinks String?
  parking       Boolean?
  cloakroom     Boolean?
}

// 1:1 к Event — заполняется только когда Event.format = MASTERCLASS.
model MasterclassDetails {
  id              String  @id @default(cuid())
  eventId         String  @unique
  event           Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  style           String?
  format          String? // свободный текст (интенсив/цикл занятий и т.п.) — не путать с Event.format
  partnerRequired Boolean @default(false)

  sessions MasterclassSession[]
}

model MasterclassSession {
  id                   String             @id @default(cuid())
  masterclassDetailsId String
  masterclassDetails   MasterclassDetails @relation(fields: [masterclassDetailsId], references: [id], onDelete: Cascade)
  title                String
  teacherId            String? // ссылается на уже существующую модель Teacher — не дублируем "инструктора" новой сущностью
  teacher              Teacher?           @relation(fields: [teacherId], references: [id])
  startTime            DateTime
  endTime              DateTime
  room                 String?
  level                DanceLevel?
  capacity             Int?
  order                Int                @default(0)

  // СЛОЙ 2 — Pass может ограничивать доступ конкретно этой сессией
  // мастер-класса (см. комментарий у PassAccessGrant).
  passAccessGrants PassAccessGrant[]

  @@index([masterclassDetailsId])
  @@index([teacherId])
}

// ---------------------------------------------------------------------------
// Festival / ProgramItem — Festival Engine
// ---------------------------------------------------------------------------
//
// Festival — САМОСТОЯТЕЛЬНАЯ сущность верхнего уровня (НЕ Event(format=
// FESTIVAL), НЕ деталь-таблица Event по образцу PartyDetails/
// MasterclassDetails — предыдущая реализация FestivalDetails/
// EventProgramItem этого типа была пересмотрена и заменена, см.
// docs/FESTIVAL_ENGINE_ER.md/FESTIVAL_ENGINE_AUDIT.md). Публикация/
// модерация/SEO/Team/Ticket-Pass фестиваля НЕ дублируются на Festival —
// они целиком идут через опционально привязанный bridge-Event (eventId,
// тот же паттерн, что Competition.eventId, D3). Продуктовое правило (не
// проверяется в БД, только в сервисном слое): фестиваль можно
// опубликовать, как только создан хотя бы один Pass (любого типа) на
// одном из событий его программы — отдельного действия "привязать
// событие" не существует, его результат — побочный эффект создания Pass.
// "Пропуска"/цены — НЕ новая сущность: переиспользуется уже существующий
// Pass/PassAccessGrant/EventPriceOption на bridge-Event. "Преподаватели
// фестиваля" — НЕ отдельный денормализованный список, а производная от
// ProgramItem.teacherId у пунктов типа WORKSHOP (тот же принцип
// переиспользования Teacher, что и MasterclassSession.teacherId).
model Festival {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  cityId      String
  city        City      @relation(fields: [cityId], references: [id])
  // Свободный текст, как Event.venueName/Competition.venue — формальной
  // модели площадки/зала в проекте нет нигде, заводить её только для
  // Festival было бы первым таким прецедентом (см. аудит §7.2).
  venueName   String?
  startsAt    DateTime
  endsAt      DateTime?
  createdById String
  createdBy   User      @relation("FestivalCreator", fields: [createdById], references: [id])
  // Bridge-Event — см. комментарий выше у модели. Nullable: черновик
  // Festival можно готовить и редактировать без привязанного события.
  eventId     String?   @unique
  event       Event?    @relation(fields: [eventId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  programItems   ProgramItem[]
  reviews        Review[]
  sponsors       FestivalSponsor[]
  faqItems       FestivalFaqItem[]
  guestQuestions FestivalGuestQuestion[]
  expenses       FestivalExpense[]
  referralCodes  FestivalReferralCode[]

  @@index([cityId])
  @@index([createdById])
}

enum FestivalProgramItemType {
  WORKSHOP
  PARTY
  COMPETITION
  OTHER
}

model ProgramItem {
  id            String                  @id @default(cuid())
  festivalId    String
  festival      Festival                @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  title         String
  type          FestivalProgramItemType
  startTime     DateTime
  endTime       DateTime?
  teacherId     String?
  teacher       Teacher?                @relation(fields: [teacherId], references: [id])
  // Опциональная ссылка на дочернее "настоящее" событие со своей публичной
  // страницей (party/workshop как отдельный Event, или CONTEST — у которого,
  // в свою очередь, уже есть Event.competition, см. D3) — не заводим
  // отдельный linkedCompetitionId, Event уже покрывает оба случая.
  linkedEventId String?
  linkedEvent   Event?                  @relation("ProgramItemLinkedEvent", fields: [linkedEventId], references: [id])
  order         Int                     @default(0)

  // Лимит мест (2026-09-17, план docs/FESTIVAL_UI_TO_DB_PLAN.md) —
  // ограничивает запись именно на этот пункт программы, отдельно от того,
  // сколько Pass продано на весь фестиваль (по образцу уже существующего
  // Event.capacity). showCapacityPublicly — организатор может вести
  // capacity только для себя, не показывая остаток гостям.
  capacity             Int?
  showCapacityPublicly Boolean @default(true)

  // СЛОЙ 2 — Pass может ограничивать доступ конкретно этим пунктом
  // программы (см. комментарий у PassAccessGrant).
  passAccessGrants PassAccessGrant[]

  @@index([festivalId])
  @@index([teacherId])
  @@index([linkedEventId])
}

// ---------------------------------------------------------------------------
// Festival Engine — доп. сущности консоли фестиваля (2026-09-17, план
// docs/FESTIVAL_UI_TO_DB_PLAN.md, продолжение UI-прототипа). Модерацию
// новых публичных (гостевых) блоков — FestivalGuestQuestion, отзывы через
// Review.festivalId — производит организатор ЭТОГО фестиваля (прямое
// решение пользователя), не сайтовый модератор: право проверяется в
// сервисном слое (isOwnerOrAdmin/EventTeamMember), а не отдельной ролью
// в схеме.
// ---------------------------------------------------------------------------

model FestivalSponsor {
  id         String   @id @default(cuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  name       String
  // Свободный текст (организатор печатает сам, напр. "Генеральный
  // спонсор") — сознательно не enum, см. docs/FESTIVAL_UI_TO_DB_PLAN.md §2.5.
  tier       String
  logoUrl    String?
  websiteUrl String?
  // Сумма денежного взноса (2026-09-17, docs/FESTIVAL_SERVICE_LAYER_PLAN.md
  // §2.2) — попадает в «Доход» вкладки «Бюджет» (прямое решение
  // пользователя). Nullable — спонсор может быть бартерным/информационным,
  // без денежного взноса вообще.
  amount     Decimal? @db.Decimal(10, 2)
  currency   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([festivalId])
}

model FestivalFaqItem {
  id         String   @id @default(cuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([festivalId])
}

// Вопрос гостя фестивалю — ДВЕ независимые оси состояния (прямое решение
// пользователя): moderationStatus (виден ли вопрос публично вообще — спам-
// фильтр организатора) и answer/answeredAt (ответил ли организатор). Вопрос
// может быть APPROVED, но ещё без ответа ("Ожидает ответа" в UI); вопрос со
// статусом PENDING/REJECTED не показывается на публичной странице вне
// зависимости от наличия ответа.
model FestivalGuestQuestion {
  id               String           @id @default(cuid())
  festivalId       String
  festival         Festival         @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  askerName        String?
  question         String
  // Анти-спам (2026-09-17, docs/FESTIVAL_SERVICE_LAYER_PLAN.md, решение
  // "нужна защита без авторизации") — форма анонимная, авторизация не
  // требуется, поэтому лимит по IP: не больше N вопросов с одного IP на
  // один фестиваль за короткое окно (см. submitGuestQuestion в
  // festival-guest-question-service.ts). Не хеш — просто текст, как и
  // остальные "технические" поля в проекте.
  submitterIp      String?
  moderationStatus ModerationStatus @default(PENDING)
  moderatedById    String?
  moderatedBy      User?            @relation("FestivalGuestQuestionModerator", fields: [moderatedById], references: [id])
  moderatedAt      DateTime?
  answer           String?
  answeredById     String?
  answeredBy       User?            @relation("FestivalGuestQuestionAnswerer", fields: [answeredById], references: [id])
  answeredAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([festivalId])
  @@index([moderationStatus])
  @@index([festivalId, submitterIp, createdAt])
}

enum FestivalExpenseCategory {
  ARTISTS
  VENUE
  MARKETING
  EQUIPMENT
  OTHER
}

enum FestivalExpenseStatus {
  PENDING
  PAID
}

model FestivalExpense {
  id         String                  @id @default(cuid())
  festivalId String
  festival   Festival                @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  title      String
  category   FestivalExpenseCategory
  amount     Decimal                 @db.Decimal(10, 2)
  currency   String?
  status     FestivalExpenseStatus   @default(PENDING)
  note       String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([festivalId])
}

// Реферальный код артиста/школы (2026-09-17) — ОТДЕЛЬНАЯ модель от
// PromoCode по прямому решению пользователя: PromoCode — это скидка
// покупателю (discountValue обязателен), реферальный код — в первую
// очередь атрибуция продаж конкретному владельцу и может существовать без
// скидки вообще (discountValue/discountType nullable). Владелец — ровно
// один из ownerTeacherId/ownerSchoolId (CHECK в migration.sql, тот же
// принцип, что и у PassAccessGrant/Review выше).
//
// discountType добавлен сверх исходного списка полей пользователя — без
// него discountValue было бы не по чему интерпретировать ("5" — это % или
// BYN); переиспользован уже существующий enum PromoDiscountType, чтобы не
// заводить третий одинаковый enum. Названия active/startsAt/expiresAt —
// как задал пользователь (у PromoCode для того же смысла —
// isActive/validFrom/validUntil; расхождение в имени сознательно оставлено
// как есть, не унифицировано без отдельного решения).
enum ReferralCommissionType {
  PERCENT
  FIXED_AMOUNT
}

model FestivalReferralCode {
  id              String                 @id @default(cuid())
  festivalId      String
  festival        Festival               @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  code            String
  ownerTeacherId  String?
  ownerTeacher    Teacher?               @relation(fields: [ownerTeacherId], references: [id])
  ownerSchoolId   String?
  ownerSchool     School?                @relation(fields: [ownerSchoolId], references: [id])
  discountType    PromoDiscountType?
  discountValue   Decimal?               @db.Decimal(10, 2)
  commissionType  ReferralCommissionType
  commissionValue Decimal                @db.Decimal(10, 2)
  active          Boolean                @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  tickets Ticket[]
  // Commerce Engine v1 — обратная связь для Order.referralCode.
  orders  Order[]

  @@unique([festivalId, code])
  @@index([festivalId])
  @@index([ownerTeacherId])
  @@index([ownerSchoolId])
}

// ---------------------------------------------------------------------------
// Review — отзыв о школе
// ---------------------------------------------------------------------------

// Отзыв о школе ИЛИ о фестивале — ровно одно из двух (2026-09-17, план
// docs/FESTIVAL_UI_TO_DB_PLAN.md, CHECK-constraint в migration.sql, тот же
// принцип, что и у PassAccessGrant). Для отзыва о фестивале модератор —
// организатор ЭТОГО фестиваля (прямое решение пользователя), не сайтовый
// модератор школ; moderatedById остаётся тем же общим полем на User,
// разграничение "кто имеет право модерировать" — проверка в сервисном
// слое (isOwnerOrAdmin по Festival.createdById/EventTeamMember), не в
// схеме.
model Review {
  id               String           @id @default(cuid())
  schoolId         String?
  school           School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  festivalId       String?
  festival         Festival?        @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  authorId         String
  author           User             @relation("ReviewAuthor", fields: [authorId], references: [id])
  rating           Int // 1..5
  text             String
  moderationStatus ModerationStatus @default(PENDING) // публикуется только после проверки модератором (см. ТЗ);
  // автор видит свой отзыв и его статус независимо от модерации
  moderatedById    String?
  moderatedBy      User?            @relation("ReviewModerator", fields: [moderatedById], references: [id])
  createdAt        DateTime         @default(now())

  @@index([schoolId])
  @@index([festivalId])
  @@index([moderationStatus])
  @@index([authorId])
  @@index([moderatedById])
}

// ---------------------------------------------------------------------------
// Dancer — профиль танцора
// ---------------------------------------------------------------------------

enum DanceRole {
  LEADER
  FOLLOWER
  BOTH
}

// Пол — отдельно от danceRole (танцевальное амплуа) и от роли в конкретном
// соревновании (Registration.role). Используется только как ПОДСКАЗКА по
// умолчанию при регистрации на конкурс (docs/00_DECISIONS.md) — ни в коем
// случае не как жёсткое правило "Leader = мужчина" (CLAUDE.md §4, §60).
enum Gender {
  MALE
  FEMALE
}

model Dancer {
  id                         String      @id @default(cuid())
  userId                     String      @unique
  user                       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName                String
  cityId                     String?
  city                       City?       @relation(fields: [cityId], references: [id])
  gender                     Gender?
  danceRole                  DanceRole?
  selfLevel                  DanceLevel?
  avatarUrl                  String?
  createdAt                  DateTime    @default(now())
  // Приз зрительских симпатий (Audience Vote) виден на публичном профиле
  // (/dancers/[id]) остальным посетителям только если сам танцор это включил;
  // самому танцору и SUPER_ADMIN — виден всегда, независимо от этого поля
  // (docs/00_DECISIONS.md, план "Приз зрительских симпатий").
  showAudienceAwardsPublicly Boolean     @default(false)

  attendances        Attendance[]
  achievements       Achievement[]
  registrations      Registration[] // СЛОЙ 3: регистрации на соревнования Jack & Jill
  eventRegistrations EventRegistration[] // Events Engine: регистрации на обычные события (НЕ путать с Registration выше — другой домен, см. комментарий у модели)
  // СЛОЙ 2 — купленные/выданные Pass (см. комментарий у модели Ticket).
  tickets            Ticket[]
  // Commerce Engine v1 — обратные связи для Order.dancer/UserPass.dancer.
  orders             Order[]
  userPasses         UserPass[]

  @@index([cityId])
}

// ---------------------------------------------------------------------------
// EventRegistration — регистрация на обычное событие (Events Engine, этап 2)
// ---------------------------------------------------------------------------
//
// НЕ путать с моделью Registration (Competition Engine, Слой 3) — та про
// J&J-соревнования с ролями LEADER/FOLLOWER и дивизионами, эта — про обычные
// Party/Masterclass/... без ролей и дивизионов (audit_report.md Risk #1:
// переиспользование Registration для обычных событий нарушило бы её
// текущие ограничения — @@unique([competitionId, divisionId, dancerId]),
// обязательный role). Активируется через уже существующий
// Event.registrationEnabled.
//
// Оплата (2026-09-16, Ticket Engine) — НЕ хранится здесь. Раньше был простой
// чекбокс isPaid/paidAt (тот же принцип, что и Registration.isPaid
// Competition Engine), но по прямому решению пользователя оплата
// унифицирована через Ticket: "1 тикет — 1 оплата", и это верно даже для
// события БЕЗ Pass — там просто заводится один passless Ticket (passId=null)
// на пару (event, dancer), см. комментарий у модели Ticket. Старые
// isPaid/paidAt перенесены в такие passless Ticket одноразовой миграцией
// (20260916060000_ticket_universal_payment) и удалены отсюда — учитывать
// оплату теперь через Ticket, не через эту модель.
enum EventRegistrationStatus {
  REGISTERED
  CONFIRMED
  WAITLIST // Event.capacity уже заполнен на момент регистрации
  CANCELLED // самим участником — статус, не физическое удаление строки
  REJECTED // решение организатора — самостоятельно участник это не отменяет (см. registration-service.ts)
  NO_SHOW
}

model EventRegistration {
  id            String                  @id @default(cuid())
  eventId       String
  event         Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dancerId      String
  dancer        Dancer                  @relation(fields: [dancerId], references: [id])
  status        EventRegistrationStatus @default(REGISTERED)
  cancelledAt   DateTime?
  // Door check-in (2026-09-16, по образцу CheckIn Competition Engine, но без
  // отдельной таблицы — здесь не нужны бирки/заезды, только факт+время+кто
  // отметил). НЕ выбирается вручную из статуса — отдельная кнопка-тумблер
  // в вкладке "Участники" (см. registration-service.ts::toggleCheckIn).
  // Организатор больше не может выбрать NO_SHOW из выпадающего списка сам
  // (см. EventRegistrationStatusSelect.tsx) — вместо этого статус
  // проставляется автоматически: если событие уже прошло, а check-in нет,
  // syncNoShowForEvent() сам переводит REGISTERED/CONFIRMED в NO_SHOW.
  checkedInAt   DateTime?
  checkedInById String?
  checkedInBy   User?                   @relation("EventRegistrationCheckedInBy", fields: [checkedInById], references: [id])
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  // Одна регистрация на пару событие-танцор — повторная попытка
  // реактивирует существующую строку (см. registerForEvent), а не создаёт
  // дубликат (тот же принцип, что и у Attendance.@@unique([dancerId, eventId])).
  @@unique([eventId, dancerId])
  @@index([eventId])
  @@index([dancerId])
  @@index([eventId, status])
}

// ---------------------------------------------------------------------------
// EventTeamMember — совместное управление событием (Events Engine, этап 5)
// ---------------------------------------------------------------------------
//
// Минимальная RBAC-модель (по прямому требованию задания — "не создавай
// сложную enterprise permission system"): OWNER не хранится отдельной
// строкой — это уже существующий Event.createdById (тот же паттерн, что и
// School.ownerUserId). Здесь — ДОПОЛНИТЕЛЬНЫЕ люди, которых владелец
// подключил к своему событию. В этой версии все не-владельческие роли дают
// ОДИНАКОВЫЙ эффективный доступ (просмотр + управление статусом/оплатой
// регистраций, см. registration-service.ts hasEventAccess) — значение role
// пока используется только для отображения "кто есть кто" в UI команды,
// разграничение возможностей по ролям — сознательно отложенная задача
// следующего прохода, а не тихо забытое требование.
enum EventTeamRole {
  MANAGER
  EDITOR
  CHECK_IN
  FINANCE
}

// QA BUG-009 (2026-09-15, P3/dormant): userId/invitedById не имеют onDelete —
// Postgres по умолчанию NO ACTION, удаление User с активным членством/
// приглашением упадёт FK-ошибкой. Сегодня в проекте вообще нет функции
// удаления аккаунта, поэтому это не действующий баг, а зафиксированный риск:
// когда такая функция появится, решить onDelete осознанно (Cascade для
// userId — членство бессмысленно без самого участника; для invitedById
// выбор менее очевиден — удаление пригласившего не должно молча стирать чужой
// доступ), а не переносить сюда решение задним числом без этого контекста.
model EventTeamMember {
  id          String        @id @default(cuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation("EventTeamMemberUser", fields: [userId], references: [id])
  role        EventTeamRole
  invitedById String
  invitedBy   User          @relation("EventTeamMemberInvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime      @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Recurring Events — EventTemplate / EventSeries (2026-09-16)
// ---------------------------------------------------------------------------
//
// Важное архитектурное решение (см. обсуждение задачи "Event Engine —
// регулярные события"): здесь НЕТ runtime-наследования Template → Series →
// Event. Оба — только заготовки, используемые В МОМЕНТ создания/генерации,
// чтобы записать конкретные значения в обычный Event. После генерации
// occurrence — самостоятельный Event, источник истины сам по себе (это и
// требует ТЗ §5/§18 "после генерации — обычный Event Engine", и совпадает с
// тем, как в проекте уже сделан JudgingCriterionCatalog → FinalCriterion,
// A32 в docs/00_DECISIONS.md — copy-on-write, не live-ссылка).

enum EventTemplateStatus {
  ACTIVE
  ARCHIVED
}

// EventTemplate — переиспользуемая заготовка настроек события (НЕ само
// событие, не публикуется, не виден в публичном каталоге). Из шаблона можно
// создать разовое событие или сразу серию (EventSeries.templateId ниже) —
// оба пути только копируют значения при создании.
model EventTemplate {
  id          String  @id @default(cuid())
  createdById String
  createdBy   User    @relation("EventTemplateCreator", fields: [createdById], references: [id])
  schoolId    String?
  school      School? @relation(fields: [schoolId], references: [id])
  name        String
  description String?

  format       EventFormat
  level        DanceLevel  @default(ALL_LEVELS)
  cityId       String?
  city         City?       @relation(fields: [cityId], references: [id])
  venueName    String?
  venueAddress String?

  // "HH:mm" — черновое время без даты, тот же приём, что уже используется
  // у ClassSchedule.startTime/endTime (schema.prisma, "без таймзон-логики").
  defaultStartTime String?
  defaultEndTime   String?

  ticketingMode       EventTicketingMode @default(UNSET)
  registrationEnabled Boolean            @default(false)
  capacity            Int?
  priceText           String?
  externalLinkUrl     String?
  tags                String[]
  certainty           EventCertainty     @default(CONFIRMED)
  photoUrl            String?
  // Тип-специфичные настройки по умолчанию (party/masterclass) — тот
  // же формат, что *DetailsInputSchema в src/server/events/schemas.ts. Json,
  // т.к. шаблон не имеет собственных строк PartyDetails/MasterclassDetails
  // (docs/02_DATABASE_SPECIFICATION.md §21 — Json только для
  // настраиваемых структур, не для нормализованных данных). FESTIVAL сюда
  // не относится — Festival больше не создаётся через EventTemplate/Wizard,
  // см. Festival Engine (docs/FESTIVAL_ENGINE_ER.md).
  typeDetails         Json?

  status    EventTemplateStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  series      EventSeries[]
  // Наследование тикетов/Pass шаблоном (2026-09-16, по прямому запросу
  // пользователя) — заготовки, из которых при создании события ИЗ ЭТОГО
  // шаблона создаются настоящие TicketType/Pass строки на новом Event (тот
  // же принцип "копирование только при создании", что и typeDetails выше,
  // НЕ live-синк). Набор полей — тот же осознанно урезанный подход, что и у
  // PassTemplate (см. комментарий там): без дат продаж/valid-периодов и без
  // soldQuantity/status/sortOrder/isActive — это состояние конкретного
  // Pass/TicketType на конкретном событии, не шаблона.
  ticketTypes EventTemplateTicketType[]
  passes      EventTemplatePass[]

  @@index([createdById])
  @@index([schoolId])
  @@index([status])
}

// Заготовка TicketType для EventTemplate — см. комментарий у
// EventTemplate.ticketTypes.
model EventTemplateTicketType {
  id              String        @id @default(cuid())
  eventTemplateId String
  eventTemplate   EventTemplate @relation(fields: [eventTemplateId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal?      @db.Decimal(10, 2)
  currency        String?
  quantity        Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([eventTemplateId])
}

// Заготовка Pass для EventTemplate — см. комментарий у EventTemplate.passes.
model EventTemplatePass {
  id                 String        @id @default(cuid())
  eventTemplateId    String
  eventTemplate      EventTemplate @relation(fields: [eventTemplateId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  type               PassType
  price              Decimal?      @db.Decimal(10, 2)
  currency           String?
  quantity           Int?
  imageUrl           String?
  allowMultipleEntry Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([eventTemplateId])
}

enum EventSeriesStatus {
  DRAFT // создана, генерация ещё не запускалась
  ACTIVE // генерирует occurrences и (если включено) публикует их
  PAUSED // организатор поставил на паузу: новые occurrences не создаются, уже созданные не трогаются
  ENDED // endDate наступила — выставляется автоматически тем же job'ом, что генерирует occurrences
  ARCHIVED // терминально, вручную
}

// EventSeries — регулярное событие ("Bachata Friday — каждую пятницу").
// Сама НЕ является Event и не показывается в публичном каталоге — публично
// видны только сгенерированные occurrences (обычные Event с seriesId).
model EventSeries {
  id            String         @id @default(cuid())
  createdById   String
  createdBy     User           @relation("EventSeriesCreator", fields: [createdById], references: [id])
  schoolId      String?
  school        School?        @relation(fields: [schoolId], references: [id])
  organizerName String?
  templateId    String?
  // SetNull, не Cascade — тот же принцип, что и JudgingCriterionCatalog→
  // FinalCriterion (A32): templateId это только след происхождения, архивация
  // или (в будущем) удаление шаблона не должны ломать уже существующую серию.
  template      EventTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  name         String
  description  String?
  format       EventFormat
  level        DanceLevel  @default(ALL_LEVELS)
  cityId       String
  city         City        @relation(fields: [cityId], references: [id])
  venueName    String
  venueAddress String?

  // IANA timezone серии ("Europe/Minsk") — ОБЯЗАТЕЛЕН (см. задачу §4):
  // используется генератором (src/server/events/recurrence.ts), чтобы
  // перевести "каждую пятницу 21:00" в конкретный UTC-инстант Event.startsAt.
  // У самого Event отдельного поля timezone нет и не заводится — после
  // генерации это обычный Event с обычным UTC startsAt, как и все остальные.
  timezone String @default("Europe/Minsk")

  // Структурированное правило повторения (НЕ свободный текст, см. задачу §4)
  // — дискриминированный union, валидируется recurrenceRuleSchema в
  // src/server/events/recurrence.ts. Json, а не отдельные колонки/enum —
  // рассчитанная на расширение конфигурация, тот же принцип, что и
  // Round.config/FinalSettings.config в движке слоя 3.
  recurrenceRule   Json
  defaultStartTime String // "HH:mm"
  defaultEndTime   String?

  startDate DateTime // календарная дата начала действия серии
  endDate   DateTime? // null = бессрочно

  // Generation horizon (задача §6): сколько дней вперёд держать
  // сгенерированными occurrences и порог, при достижении которого генератор
  // досоздаёт следующие.
  generationHorizonDays   Int @default(84) // 12 недель
  generationThresholdDays Int @default(28) // 4 недели

  // Auto publish (задача §7, уточнено пользователем — не "за N минут до
  // старта" единым числом, а "за N дней, в HH:mm" — иначе публикация могла
  // бы случайно попасть на 3 часа ночи). Оба поля обязательны вместе, когда
  // autoPublish=true (проверяется в event-series-service.ts, не в схеме).
  // publishDaysBefore=0 — публиковать в день самого события, в publishAtTime.
  autoPublish       Boolean @default(false)
  publishDaysBefore Int?
  publishAtTime     String? // "HH:mm", тот же формат, что defaultStartTime

  ticketingMode       EventTicketingMode @default(UNSET)
  registrationEnabled Boolean            @default(false)
  capacity            Int?
  priceText           String?
  externalLinkUrl     String?
  tags                String[]
  certainty           EventCertainty     @default(CONFIRMED)
  photoUrl            String?
  typeDetails         Json?

  status EventSeriesStatus @default(ACTIVE)

  // Курсор генератора — до какой календарной даты уже сгенерированы
  // occurrences (НЕ "количество", т.к. WEEKLY с несколькими днями недели даёт
  // несколько occurrences на "неделю горизонта" — см. §6 задачи). Позволяет
  // генератору не пересканировать с самого startDate на каждом тике.
  lastGeneratedThrough DateTime?
  lastGeneratedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([createdById])
  @@index([schoolId])
  @@index([status, lastGeneratedThrough])
}

// ---------------------------------------------------------------------------
// Attendance — отметка посещения
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  GOING // «иду»
  WENT // «был»
}

enum AttendanceSource {
  SELF_REPORTED // сегодня — единственный источник, декларативный, без подтверждения оплатой
  // СЛОЙ 2: сюда добавится значение типа CONFIRMED_REGISTRATION,
  // когда посещение будет подтверждаться оплаченной регистрацией.
}

model Attendance {
  id        String           @id @default(cuid())
  dancerId  String
  dancer    Dancer           @relation(fields: [dancerId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  source    AttendanceSource @default(SELF_REPORTED)
  createdAt DateTime         @default(now())

  @@unique([dancerId, eventId]) // одна отметка на пару танцор-событие, статус можно менять
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Achievement — достижение танцора
// ---------------------------------------------------------------------------

enum AchievementSource {
  MANUAL // сегодня — заполняется вручную самим танцором
  CONTEST_RESULT // СЛОЙ 3: зарезервировано под автоматические записи от судейского модуля
}

model Achievement {
  id          String            @id @default(cuid())
  dancerId    String
  dancer      Dancer            @relation(fields: [dancerId], references: [id], onDelete: Cascade)
  description String // «вышел в финал такого-то конкурса»
  achievedAt  DateTime
  source      AchievementSource @default(MANUAL)
  eventId     String? // необязательная ссылка на событие
  event       Event?            @relation(fields: [eventId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([dancerId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// ModerationLog — журнал модераторских решений
// ---------------------------------------------------------------------------

enum ModerationEntity {
  EVENT
  REVIEW
  ACCESS_REQUEST
  SCHOOL
  USER
  EVENT_SUGGESTION
  // Legacy — SchoolClaim удалена из схемы (2026-09-14, заменена AccessRequest),
  // но в БД физически остались исторические строки ModerationLog с этим
  // значением (DROP TABLE/enum-rebuild заблокирован классификатором
  // авто-режима даже при явном разрешении — см. docs/00_DECISIONS.md). Убирать
  // это значение из схемы НЕЛЬЗЯ: Postgres enum содержит его физически, и без
  // объявления здесь Prisma падает в рантайме при чтении ЛЮБОЙ строки
  // ModerationLog, если среди них есть хоть одна с этим значением (найдено
  // вживую на проде — /admin/system/moderation/log падал с 500). Никакой код
  // больше не пишет это значение, только читает уже существующие строки.
  SCHOOL_CLAIM
}

model ModerationLog {
  id        String           @id @default(cuid())
  actorId   String
  actor     User             @relation("ModerationActor", fields: [actorId], references: [id])
  entity    ModerationEntity
  entityId  String
  action    String // "approved", "rejected", "blocked", ...
  reason    String?
  createdAt DateTime         @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

// ============================================================================
// Слой 3 — движок соревнований Bachata Jack & Jill
// ============================================================================
// Этап 1 (фундамент): RBAC, соревнование/дивизион/правила, раунды/заезды,
// аудит. Решения и обоснования — docs/00_DECISIONS.md.
//
// Draw/heat-participants/судейство/scoring/advancement/tie-break/результаты
// в этот этап НЕ входят — модели для них проектируются и добавляются на
// следующих этапах (см. docs/00_DECISIONS.md, открытые вопросы C1–C9).
// ============================================================================

enum CompetitionStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  CHECK_IN
  READY
  LIVE
  SCORING
  REVIEW
  PUBLISHED
  ARCHIVED
}

// Без отдельного значения RESUMED — это переход (PAUSED -> RUNNING), а не
// состояние (см. docs/00_DECISIONS.md, A2).
enum RoundStatus {
  DRAFT
  READY
  DRAWING
  DRAW_LOCKED
  RUNNING
  PAUSED
  FINISHED
  SCORING
  COMPLETED
}

enum HeatStatus {
  PENDING
  RUNNING
  PAUSED
  FINISHED
}

// Живой танцпол / ротация партнёров (Этап 6, docs/00_DECISIONS.md, A12).
// Два независимых, реально используемых в зале сценария — пользователь
// подтвердил, что это два разных режима, не переключатели одного сценария:
// TRACK_AUTO_SHIFT — играет целый трек, программа сама (по таймеру) каждые
// rotationIntervalSec показывает "СМЕНА" (партнёры сдвигаются на 1, всегда
// на одного) прямо во время трека; SEGMENT_MANUAL_SHIFT — играет отрезок
// трека, DJ вручную жмёт "Стоп", после чего выбирается число N (диапазон
// rotationShiftMin..rotationShiftMax), на сколько партнёров переходят.
// Программа НЕ хранит и не назначает конкретные пары (A5) — только считает
// время и показывает надписи на экране, без звука.
enum RotationMode {
  TRACK_AUTO_SHIFT
  SEGMENT_MANUAL_SHIFT
}

// Без RESUMED — как и у Round/Heat, возобновление это переход
// (PAUSED -> RUNNING), не отдельное состояние (A2), см. 03 §10.
enum RotationStatus {
  IDLE
  RUNNING
  PAUSED
  FINISHED
}

enum RoundType {
  PRELIMINARY
  CALLBACK
  QUARTERFINAL
  SEMIFINAL
  FINAL
  TIE_BREAK
  DANCE_OFF
}

// GLOBAL — роль действует на весь движок (напр. SUPER_ADMIN).
// COMPETITION — роль назначается точечно, на конкретное соревнование
// (через CompetitionMember), напр. HEAD_JUDGE или JUDGE.
enum RoleScope {
  GLOBAL
  COMPETITION
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Permission {
  id   String @id @default(cuid())
  code String @unique // "competition:create", "draw:lock", "judge:score", ...
  name String

  rolePermissions RolePermission[]
}

model Role {
  id    String    @id @default(cuid())
  code  String    @unique // SUPER_ADMIN, EVENT_ADMIN, HEAD_JUDGE, JUDGE, SCORER, DJ, MC, COMPETITOR
  name  String
  scope RoleScope

  permissions       RolePermission[]
  userAssignments   UserRoleAssignment[]
  memberAssignments CompetitionMember[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// Глобальное назначение роли пользователю (напр. SUPER_ADMIN). Роль внутри
// конкретного соревнования — через CompetitionMember, не здесь.
model UserRoleAssignment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserRoleAssignee", fields: [userId], references: [id], onDelete: Cascade)
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedAt   DateTime @default(now())
  grantedById String?
  grantedBy   User?    @relation("UserRoleGrantor", fields: [grantedById], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([grantedById])
  @@index([roleId])
}

// Роль пользователя внутри конкретного соревнования — реализует шаг
// "competition membership" конвейера авторизации (03 §3).
model CompetitionMember {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation("CompetitionMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id])
  addedAt       DateTime    @default(now())
  addedById     String?
  addedBy       User?       @relation("CompetitionMemberGrantor", fields: [addedById], references: [id])

  @@unique([competitionId, userId, roleId])
  @@index([competitionId])
  @@index([userId])
  @@index([addedById])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Соревнование / дивизион / правила
// ---------------------------------------------------------------------------

model CompetitionTemplate {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String
  version String
  rules   Json
  active  Boolean @default(true)

  competitions Competition[]
}

model Competition {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  description   String?
  organizerName String?
  venue         String?
  cityId        String?
  city          City?                @relation(fields: [cityId], references: [id])
  timezone      String               @default("Europe/Minsk")
  startAt       DateTime?
  endAt         DateTime?
  status        CompetitionStatus    @default(DRAFT)
  statusVersion Int                  @default(1) // оптимистичная блокировка при переходах состояния (03 §27)
  templateId    String?
  template      CompetitionTemplate? @relation(fields: [templateId], references: [id])
  eventId       String?              @unique // афишная карточка слоя 1; nullable — соревнование может быть без публичной афиши
  event         Event?               @relation(fields: [eventId], references: [id])
  publicResults Boolean              @default(false)
  // Публичная страница (Этап 12) — чисто информационные поля для зрителей,
  // ни на что в движке не влияют. rulesText/rulesUrl — организатор заполняет
  // любое из двух (или оба); mediaUrl — ссылка на внешний альбом/плейлист
  // (по решению пользователя, 2026-09-05, без загрузки файлов на свой сервер).
  rulesText     String?
  rulesUrl      String?
  mediaUrl      String?
  createdById   String
  createdBy     User                 @relation("CompetitionCreator", fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  rules         CompetitionRules[]
  divisions     Division[]
  members       CompetitionMember[]
  registrations Registration[]
  checkIns      CheckIn[]

  @@index([status])
  @@index([cityId])
  @@index([createdById])
  @@index([templateId])
}

// Версии правил соревнования. Unique по (competitionId, version), НЕ по
// одному competitionId — иначе Round.rulesId не на что было бы ссылаться
// при появлении новой версии правил (docs/00_DECISIONS.md, A1).
model CompetitionRules {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  version       Int
  rules         Json
  lockedAt      DateTime?
  lockedById    String?
  lockedBy      User?       @relation("CompetitionRulesLocker", fields: [lockedById], references: [id])
  createdAt     DateTime    @default(now())

  rounds Round[]

  @@unique([competitionId, version])
  @@index([competitionId])
  @@index([lockedById])
}

// Общий для всех соревнований справочник категорий — редактирует только
// SUPER_ADMIN (добавление/деактивация, не физическое удаление — иначе
// потерялась бы связь с уже существующими Division/Registration,
// CLAUDE.md §18). Организатор конкретного соревнования просто выбирает
// нужные категории отсюда при создании дивизионов, а не придумывает
// названия сам. Уровень никак не ограничивает регистрацию — это подпись,
// не правило.
model DivisionCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)

  divisions Division[]
}

// Глобальный справочник критериев оценки (Справочники → Оценочные
// показатели, judging_criteria:manage, только SUPER_ADMIN) — критерии
// повторяются из соревнования в соревнование (пользователь, 2026-09-08), по
// образцу DivisionCategory/RoundStageCatalog выше. isActive — мягкое
// скрытие (CLAUDE.md §18), не физическое удаление. Выбор из справочника на
// дивизионе КОПИРУЕТ значения в FinalCriterion на момент выбора — catalogId
// там только след происхождения, не живая ссылка: правка каталога задним
// числом не должна тихо менять уже настроенный/идущий финал (CLAUDE.md
// §50-51).
model JudgingCriterionCatalog {
  id        String   @id @default(cuid())
  name      String   @unique
  minScore  Int
  maxScore  Int
  step      Int      @default(1)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  criteria FinalCriterion[]
}

model Division {
  id                  String           @id @default(cuid())
  competitionId       String
  competition         Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  categoryId          String
  category            DivisionCategory @relation(fields: [categoryId], references: [id])
  minAge              Int?
  maxAge              Int?
  maxParticipants     Int?
  // Сколько пар помещается на паркет одновременно — используется при
  // авто-генерации раундов/заездов (docs/00_DECISIONS.md, A7), чтобы
  // посчитать, на сколько заездов делить раунд. Можно переопределить для
  // конкретного раунда через Round.heatCapacity.
  heatCapacity        Int              @default(10)
  // Настройки ротации партнёров по умолчанию для раундов этого дивизиона
  // (Этап 6, A12) — можно переопределить на уровне конкретного Round, как и
  // heatCapacity (A7). rotationShiftMin/Max используются только в режиме
  // SEGMENT_MANUAL_SHIFT — диапазон, из которого выбирается N.
  rotationMode        RotationMode     @default(TRACK_AUTO_SHIFT)
  rotationIntervalSec Int              @default(30)
  rotationShiftMin    Int              @default(1)
  rotationShiftMax    Int              @default(3)
  // Метод оценки раундов ДО финала для этого дивизиона (1 = "Да/Нет",
  // 2 = "0/1/2" с квотой по числу проходящих) — задаётся один раз при
  // создании дивизиона (как DivisionStagePlan, A14), не редактируется через
  // DivisionSettingsPanel. generateRounds() использует это значение как
  // Round.judgingMaxScore для каждого создаваемого раунда.
  judgingMaxScore     Int              @default(1)
  rules               Json
  createdAt           DateTime         @default(now())

  // Отметка "результаты дивизиона проверены перед публикацией" (Этап 10,
  // 03 §23 — result:review) — предпосылка для publishCompetitionResults().
  // Не хранится отдельной таблицей: это состояние ровно одного дивизиона,
  // как и heatCapacity/rotation* выше.
  resultsReviewedAt   DateTime?
  resultsReviewedById String?
  resultsReviewedBy   User?     @relation("DivisionResultsReviewedBy", fields: [resultsReviewedById], references: [id])

  rounds           Round[]
  registrations    Registration[]
  judgeAssignments JudgeAssignment[]
  stagePlan        DivisionStagePlan[]
  finalCriteria    FinalCriterion[]
  finalSettings    FinalSettings?
  results          Result[]
  audienceVote     AudienceVote?

  @@unique([competitionId, categoryId])
  @@index([categoryId])
  @@index([resultsReviewedById])
}

// Общий для всех соревнований справочник этапов отбора (Отборочный,
// Четвертьфинал, Полуфинал, Финал...) — управляет только SUPER_ADMIN, как и
// DivisionCategory (docs/00_DECISIONS.md, A7). defaultAdvanceCount —
// стандартное "сколько проходит дальше" для этого этапа, используется как
// значение по умолчанию при создании/авто-генерации раунда, но
// переопределяется на уровне конкретного Round под размер дивизиона.
model RoundStageCatalog {
  id                  String  @id @default(cuid())
  name                String  @unique
  order               Int     @default(0)
  isActive            Boolean @default(true)
  defaultAdvanceCount Int

  rounds        Round[]
  divisionPlans DivisionStagePlan[]
}

// План "сколько пар участвует в каждом этапе" для КОНКРЕТНОГО дивизиона —
// задаётся один раз при создании дивизиона (до начала соревнования) и
// дальше не меняется, т.к. на него опирается расчёт cutoff (Advancement
// Engine, A13): finalistsCount раунда этапа X = participantCount СЛЕДУЮЩЕГО
// по порядку сконфигурированного этапа (пользователь подтвердил
// 2026-09-04). Заменяет прежний способ ("Сколько проходит дальше" при
// ручном добавлении раунда) — см. docs/00_DECISIONS.md, A14.
model DivisionStagePlan {
  id               String            @id @default(cuid())
  divisionId       String
  division         Division          @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  stageId          String
  stage            RoundStageCatalog @relation(fields: [stageId], references: [id])
  participantCount Int
  createdAt        DateTime          @default(now())

  @@unique([divisionId, stageId])
  @@index([stageId])
}

// ---------------------------------------------------------------------------
// Раунды / заезды
// ---------------------------------------------------------------------------

model Round {
  id                  String             @id @default(cuid())
  divisionId          String
  division            Division           @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  // Ровно одно из двух: stageId — обычный раунд организатора, выбранный из
  // общего справочника этапов (имя берётся из stage.name, свободного текста
  // больше нет); type — служебный раунд, который заводит сам движок
  // (TIE_BREAK/DANCE_OFF, Этап 8), в справочник не входит. Обеспечено CHECK
  // constraint в миграции (docs/00_DECISIONS.md, A7).
  stageId             String?
  stage               RoundStageCatalog? @relation(fields: [stageId], references: [id])
  type                RoundType?
  order               Int
  status              RoundStatus        @default(DRAFT)
  statusVersion       Int                @default(1)
  // Обязателен для stageId-раундов (проверяется в сервисе, не в схеме — тай-брейк
  // без справочника может создаваться и без этого числа сразу).
  finalistsCount      Int?
  // Переопределяет Division.heatCapacity для этого конкретного раунда (напр.
  // финал часто идёт одним заездом независимо от общего правила).
  heatCapacity        Int?
  // Переопределяют настройки ротации партнёров дивизиона для этого раунда
  // (Этап 6, A12) — напр. у финала обычно другие правила, чем у отборочных.
  rotationMode        RotationMode?
  rotationIntervalSec Int?
  rotationShiftMin    Int?
  rotationShiftMax    Int?
  config              Json               @default("{}")
  rulesId             String // версия CompetitionRules, действовавшая на момент создания раунда (02 §4)
  rules               CompetitionRules   @relation(fields: [rulesId], references: [id])
  // Шкала судейской оценки в этом раунде: 1 = 0/1 (проходит/не проходит),
  // 2 = 0/1/2 (Этап 7, реже перетанцовки при бОльшем разбросе). Снимок этого
  // значения кладётся в каждый JudgeScore.maxValue — смена шкалы позже не
  // должна задним числом менять смысл уже выставленных оценок (CLAUDE.md §51).
  judgingMaxScore     Int                @default(1)
  // Заполнено только для служебных раундов TIE_BREAK/DANCE_OFF (Этап 8) —
  // какой обычный раунд эту перетанцовку породил. Перетанцовка перетанцовки
  // не бывает (подтверждено пользователем) — эта ссылка всегда указывает на
  // НЕ-служебный раунд.
  tieBreakOfRoundId   String?
  tieBreakOfRound     Round?             @relation("RoundTieBreakOf", fields: [tieBreakOfRoundId], references: [id])
  tieBreakRounds      Round[]            @relation("RoundTieBreakOf")
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime           @default(now())

  // Публикация списка "кто прошёл дальше" этого раунда (Этап 10) — отдельно
  // и раньше, чем публикация финальных мест всего соревнования: организатор
  // может показать промежуточные списки сразу после раунда, не дожидаясь
  // конца всего конкурса (уточнено пользователем, 2026-09-04). Не
  // применяется к финальному раунду дивизиона — там места публикуются вместе
  // со всем соревнованием через publishCompetitionResults (Result).
  advancementPublishedAt   DateTime?
  advancementPublishedById String?
  advancementPublishedBy   User?     @relation("RoundAdvancementPublishedBy", fields: [advancementPublishedById], references: [id])

  heats                  Heat[]
  results                RoundResult[]
  confirmations          JudgeRoundConfirmation[]
  finalSession           FinalSession?
  finalResults           FinalResult[]
  officialResultsReached Result[]                 @relation("ResultRoundReached")

  @@unique([divisionId, order])
  @@index([status])
  @@index([advancementPublishedById])
  @@index([rulesId])
  @@index([stageId])
  @@index([tieBreakOfRoundId])
}

model Heat {
  id            String     @id @default(cuid())
  roundId       String
  round         Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  number        Int
  status        HeatStatus @default(PENDING)
  statusVersion Int        @default(1)
  startedAt     DateTime?
  endedAt       DateTime?

  draws             Draw[]
  rotation          HeatRotation?
  finalPair         FinalPair?
  heatConfirmations JudgeHeatConfirmation[]

  @@unique([roundId, number])
}

// ---------------------------------------------------------------------------
// Живой танцпол — ротация партнёров (Этап 6, docs/00_DECISIONS.md, A12)
// ---------------------------------------------------------------------------

// Ровно одна строка на Heat — таймер/состояние ротации, сервер источник
// времени (CLAUDE.md §12). mode/intervalSec/shiftMin/shiftMax — СНИМОК
// настроек дивизиона/раунда на момент старта (startRotation): если
// организатор поменяет настройки дивизиона позже, уже идущий/прошедший
// заезд не должен измениться задним числом (CLAUDE.md §50/§51).
model HeatRotation {
  id            String         @id @default(cuid())
  heatId        String         @unique
  heat          Heat           @relation(fields: [heatId], references: [id], onDelete: Cascade)
  status        RotationStatus @default(IDLE)
  statusVersion Int            @default(1) // оптимистичная блокировка, как у Round/Heat (03 §27)

  mode        RotationMode
  intervalSec Int
  shiftMin    Int
  shiftMax    Int

  trackNumber      Int       @default(0)
  trackName        String?
  // Начало текущего трека/отрезка с точки зрения сервера — единственный
  // источник истины для отсчёта, клиент только отрисовывает обратный
  // отсчёт по этому времени (CLAUDE.md §12). При паузе не меняется, при
  // возобновлении сдвигается вперёд на длительность паузы.
  segmentStartedAt DateTime?
  pausedAt         DateTime?

  // Режим SEGMENT_MANUAL_SHIFT: после "Стоп" заезд ждёт, пока DJ выберет N
  // (случайно — с сохранением seed, CLAUDE.md §6 — или вручную), прежде чем
  // можно будет запустить следующий отрезок.
  awaitingShiftChoice Boolean @default(false)
  pendingShiftN       Int?
  pendingShiftSource  String? // RANDOM | MANUAL
  pendingShiftSeed    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Жеребьёвка (Draw Engine, Этап 5)
// ---------------------------------------------------------------------------

// Конкретные пары НЕ хранятся и не назначаются движком (docs/00_DECISIONS.md,
// A5) — участников вызывают по одному, пары образуются уже на паркете, это
// физически не контролируется программой. Draw — один акт "сформировали
// список вызванных для этого заезда"; версионируется как и CompetitionRules
// (A1) — reroll не удаляет старую версию, создаёт новую (CLAUDE.md §6).
model Draw {
  id               String   @id @default(cuid())
  heatId           String
  heat             Heat     @relation(fields: [heatId], references: [id], onDelete: Cascade)
  version          Int
  // null при callOrder=SEQUENTIAL — порядок детерминирован номерами
  // участников, случайности нет, сохранять нечего.
  seed             String?
  algorithmVersion String
  createdById      String
  createdBy        User     @relation("DrawCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  reason           String? // обязателен при reroll (версия > 1), не при первом формировании

  participants DrawParticipant[]

  @@unique([heatId, version])
  @@index([createdById])
}

// GUEST_HIGHER_CATEGORY — участник другого дивизиона этого же соревнования
// (не обязательно строго "старше" по DivisionCategory.order — это только
// подсказка по умолчанию в UI, в коде не проверяется, docs/00_DECISIONS.md).
// REUSED_ALREADY_SCORED — участник ЭТОГО ЖЕ дивизиона/раунда, уже получивший
// scored=true в более раннем заезде этого раунда, помогает повторно без
// повторной оценки.
enum DrawHelperSource {
  GUEST_HIGHER_CATEGORY
  REUSED_ALREADY_SCORED
  // Ниже — источники для судей-партнёров JUDGES_DANCE (final-judges-dance.ts),
  // когда реальных назначенных судей противоположной роли не хватает на всех
  // финалистов захода. Порядок каскада (по прямому запросу пользователя,
  // 2026-09-10): категория выше (GUEST_HIGHER_CATEGORY, уже есть) -> своя
  // категория, не прошедшие в этот финал (SAME_CATEGORY_NON_FINALIST) ->
  // финалисты противоположной роли ЭТОГО ЖЕ финала, ещё не танцевавшие свою
  // стадию (OWN_FINAL_OPPOSITE_ROLE).
  SAME_CATEGORY_NON_FINALIST
  OWN_FINAL_OPPOSITE_ROLE
}

model DrawParticipant {
  id             String            @id @default(cuid())
  drawId         String
  draw           Draw              @relation(fields: [drawId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration      @relation(fields: [registrationId], references: [id])
  role           RegistrationRole
  // Считается ли эта попытка в зачёт участнику в этом раунде. Помощник
  // (гость или уже отработавший) — всегда false, CLAUDE.md §16: judge
  // оценивает competitor, не пару.
  scored         Boolean           @default(true)
  helperSource   DrawHelperSource?
  calledOrder    Int // порядок вызова на паркет в рамках этого Draw

  judgeScores      JudgeScore[]
  finalJudgeScores FinalJudgeScore[]

  @@unique([drawId, registrationId])
  @@index([registrationId])
}

// ---------------------------------------------------------------------------
// Судейство (Этап 7) и определение проходящих / перетанцовка (Этап 8)
// ---------------------------------------------------------------------------

// Судья закреплён на дивизион и роль, которую судит (LEADER/FOLLOWER) — не на
// пол участника: пол судьи по умолчанию совпадает с ролью, которую он судит,
// но это подсказка при назначении, не правило (уточнено пользователем
// 2026-09-04, заменяет прежнюю формулировку A6 — см. docs/00_DECISIONS.md).
// Один судья может быть закреплён на несколько дивизионов (в т.ч. на обе
// роли одного дивизиона при нехватке судей) — @@unique держит только пару
// "дивизион+роль" уникальной на одного судью.
model JudgeAssignment {
  id           String           @id @default(cuid())
  divisionId   String
  division     Division         @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  judgeUserId  String
  judge        User             @relation("JudgeAssignmentJudge", fields: [judgeUserId], references: [id])
  role         RegistrationRole
  assignedById String
  assignedBy   User             @relation("JudgeAssignmentAssignedBy", fields: [assignedById], references: [id])
  createdAt    DateTime         @default(now())

  scores            JudgeScore[]
  confirmations     JudgeRoundConfirmation[]
  finalScores       FinalJudgeScore[]
  heatConfirmations JudgeHeatConfirmation[]

  @@unique([divisionId, judgeUserId, role])
  @@index([assignedById])
  @@index([judgeUserId])
}

// Оценка одного судьи по одному вызванному участнику (scored=true) в
// конкретном заходе — CLAUDE.md §16: judge оценивает competitor, не пару.
// value — 0..maxValue (снимок Round.judgingMaxScore на момент отправки).
model JudgeScore {
  id                 String          @id @default(cuid())
  drawParticipantId  String
  drawParticipant    DrawParticipant @relation(fields: [drawParticipantId], references: [id], onDelete: Cascade)
  judgeAssignmentId  String
  judgeAssignment    JudgeAssignment @relation(fields: [judgeAssignmentId], references: [id])
  value              Int
  maxValue           Int
  // Ключ идемпотентности офлайн-очереди клиента (CLAUDE.md §17) — если
  // повторная отправка приходит с тем же clientSubmissionId, что уже
  // сохранён, сервер её не применяет повторно (сеть могла потерять только
  // ответ, а не сам запрос). Новое значение от судьи (ручное изменение)
  // всегда несёт новый clientSubmissionId и обрабатывается как обычно.
  clientSubmissionId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([drawParticipantId, judgeAssignmentId])
  @@index([judgeAssignmentId])
}

// Формат 0/1 ("Да/Нет"): судья свободно кликает "Да" по паркету, сколько
// хочет, сколько угодно раз меняя мнение — но раунд не ждёт от него явного
// "Нет" по каждому оставшемуся (CLAUDE.md §16 всё равно соблюдён: "нет
// оценки" не превращается в 0 задним числом, отсутствующая JudgeScore
// просто не прибавляет баллов в сумме). Вместо этого судья явно нажимает
// "Готово" — принимается, только если "Да" ровно Round.finalistsCount;
// после этого его оценки по этому раунду фиксируются (submitJudgeScore
// больше их не принимает). Раунд реально завершается и перестаёт принимать
// оценки только когда так подтвердили ВСЕ судьи раунда (по обеим ролям, где
// судейство не пропущено) — по запросу пользователя, 2026-09-04.
model JudgeRoundConfirmation {
  id                String          @id @default(cuid())
  roundId           String
  round             Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  judgeAssignmentId String
  judgeAssignment   JudgeAssignment @relation(fields: [judgeAssignmentId], references: [id], onDelete: Cascade)
  // Снимок числа "Да" (формат 0/1) на момент подтверждения — для
  // истории/аудита, не пересчитывается позже. Для формата "0/1/2"
  // (Round.judgingMaxScore=2) это же поле хранит количество оценок "2"
  // (переиспользуется, не переименовано — нигде не отображается в UI).
  yesCount          Int
  createdAt         DateTime        @default(now())

  @@unique([roundId, judgeAssignmentId])
  @@index([judgeAssignmentId])
}

// Подтверждение "Готово" ПО ЗАХОДУ — только для формата JUDGES_DANCE
// (2026-09-10). В этом формате заходы стадий появляются не все сразу
// (final-judges-dance.ts, generateJudgesDanceStage: стадия 2 формируется
// отдельным действием организатора ПОСЛЕ того, как стадия 1 завершена) —
// общее JudgeRoundConfirmation "на весь раунд" ошибочно блокировало судью,
// назначенного на обе роли: он подтверждал "Готово" сразу после стадии 1
// (тогда это и правда было всё, что видно), а когда позже появлялась стадия
// 2 со своим единственным критерием — новые обязательные клетки становились
// недоступны (жалоба пользователя: "судья не может этого сделать"). Для
// остальных форматов финала (там все заходы формируются сразу при старте)
// это не воспроизводится — они продолжают использовать JudgeRoundConfirmation
// без изменений; submitFinalJudgeScore/confirmFinalJudgeHeatDone проверяют
// именно эту модель только когда FinalSession.format = JUDGES_DANCE.
model JudgeHeatConfirmation {
  id                String          @id @default(cuid())
  heatId            String
  heat              Heat            @relation(fields: [heatId], references: [id], onDelete: Cascade)
  judgeAssignmentId String
  judgeAssignment   JudgeAssignment @relation(fields: [judgeAssignmentId], references: [id], onDelete: Cascade)
  yesCount          Int
  createdAt         DateTime        @default(now())

  @@unique([heatId, judgeAssignmentId])
  @@index([judgeAssignmentId])
}

// Итог Advancement Engine по раунду на одного участника (CLAUDE.md §23).
// TIE_BREAK_REQUIRED — только для тех, кого затронула ничья на границе
// cutoff; остальные однозначно ADVANCED/ELIMINATED уже на этом раунде.
// Решение перетанцовки (Этап 8) обновляет статус этих же строк на
// ADVANCED/ELIMINATED — новых строк на родительском раунде не создаётся,
// но сама перетанцовка ведётся отдельным служебным Round (tieBreakOfRoundId)
// со своими RoundResult, чтобы решение было видно и в аудите отдельно.
model RoundResult {
  id             String            @id @default(cuid())
  roundId        String
  round          Round             @relation(fields: [roundId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration      @relation(fields: [registrationId], references: [id])
  scoreSum       Int
  rank           Int
  status         AdvancementStatus
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([roundId, registrationId])
  @@index([registrationId])
}

enum AdvancementStatus {
  ADVANCED
  ELIMINATED
  TIE_BREAK_REQUIRED
}

// ---------------------------------------------------------------------------
// Финал (Этап 9, docs/00_DECISIONS.md, A22)
// ---------------------------------------------------------------------------
// Судейство финала — отдельная от обычной (JudgeScore) система: не одна
// оценка 0..judgingMaxScore на участника, а несколько КРИТЕРИЕВ со своим
// диапазоном каждый. "Приоритет" критерия — НЕ коэффициент: оценки не
// умножаются и не нормализуются, общая сумма всегда простая арифметическая
// сумма. priority используется ТОЛЬКО как порядок сравнения критериев при
// полном равенстве общей суммы (лексикографический tie-break) — пользователь
// подтвердил явно (2026-09-04), это НЕ Relative Placement и НЕ weighted
// score. Переиспользует Round/Heat/Draw/DrawParticipant (вызов на паркет) и
// JudgeAssignment (судья закреплён на роль, не пол — A6/A13) как есть.

enum FinalFormat {
  NORMAL // обычный J&J-финал — участники вызываются как в обычных раундах
  JUDGES_DANCE // финалисты одной роли по очереди танцуют с судьями противоположной роли
  RANDOM_COUPLES // случайные пары финалистов, каждая пара танцует отдельно
  RELATIVE_PLACEMENT // судьи ставят места напрямую (1..N, без повторов) — итог считается системой "скейтинг" (final-ranking.ts), а не суммой критериев
}

// Критерии оценки финала — на уровне Division (конкретная категория
// конкретного соревнования), редактируются организатором до старта финала.
// priority уникален и должен быть последователен (1..N) в рамках дивизиона —
// проверяется в сервисе при старте финала, не в схеме.
model FinalCriterion {
  id         String                   @id @default(cuid())
  divisionId String
  division   Division                 @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name       String
  priority   Int // 1 = сравнивается первым при разрешении полной ничьей по общей сумме
  minScore   Int
  maxScore   Int
  step       Int                      @default(1)
  sortOrder  Int                      @default(0)
  isActive   Boolean                  @default(true)
  createdAt  DateTime                 @default(now())
  // Из какой записи справочника скопированы значения при выборе (не живая
  // ссылка — см. комментарий у JudgingCriterionCatalog выше). Nullable —
  // критерий мог быть введён вручную с нуля, без справочника.
  catalogId  String?
  catalog    JudgingCriterionCatalog? @relation(fields: [catalogId], references: [id])

  scores FinalJudgeScore[]

  @@unique([divisionId, priority])
}

// Настройки формата финала для дивизиона — задаются один раз до старта,
// после старта фиксируются снимком в FinalSession (CLAUDE.md §50-51).
// config — доп. параметры конкретного формата (напр. scoring-matrix для
// JUDGES_DANCE — какая роль судьи что оценивает на какой стадии), не
// заменяет основные поля целиком JSON-ом.
model FinalSettings {
  id                   String      @id @default(cuid())
  divisionId           String      @unique
  division             Division    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  format               FinalFormat @default(NORMAL)
  tracksCount          Int         @default(1)
  partnerChangeEnabled Boolean     @default(false)
  config               Json        @default("{}")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

// Снимок правил финала на момент старта (1:1 к Round-финалу) — после этого
// изменение FinalSettings/FinalCriterion этого дивизиона больше не влияет на
// уже идущий/прошедший финал. currentStage — только для JUDGES_DANCE (1 —
// первая по очереди роль танцует с судьями противоположной роли, 2 —
// наоборот); null для остальных форматов.
model FinalSession {
  id               String      @id @default(cuid())
  roundId          String      @unique
  round            Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  format           FinalFormat
  criteriaSnapshot Json // [{ id, name, priority, minScore, maxScore, step }]
  config           Json        @default("{}") // снимок FinalSettings.config (scoring-matrix и т.п.)
  currentStage     Int?
  startedAt        DateTime    @default(now())
  completedAt      DateTime?

  pairs   FinalPair[]
  results FinalResult[]
}

// Только формат RANDOM_COUPLES — одна случайно сформированная пара.
// Жеребьёвка выполняется сервером и сохраняется сразу (CLAUDE.md §6) —
// повторный вызов/обновление страницы не меняет ни пару, ни трек. Каждая
// пара — свой Heat (переиспользует эксклюзивность паркета, A4 — пары и так
// танцуют по одной). trackName — свободный текст, как уже принято для
// HeatRotation.trackName; отдельного каталога треков в проекте нет.
model FinalPair {
  id                     String       @id @default(cuid())
  finalSessionId         String
  finalSession           FinalSession @relation(fields: [finalSessionId], references: [id], onDelete: Cascade)
  heatId                 String       @unique
  heat                   Heat         @relation(fields: [heatId], references: [id], onDelete: Cascade)
  pairNumber             Int
  leaderRegistrationId   String
  leaderRegistration     Registration @relation("FinalPairLeader", fields: [leaderRegistrationId], references: [id])
  followerRegistrationId String
  followerRegistration   Registration @relation("FinalPairFollower", fields: [followerRegistrationId], references: [id])
  trackName              String?
  seed                   String // сохранённый seed рандомизации (CLAUDE.md §6)
  createdById            String
  createdBy              User         @relation("FinalPairCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime     @default(now())

  @@unique([finalSessionId, pairNumber])
  @@index([createdById])
  @@index([followerRegistrationId])
  @@index([leaderRegistrationId])
}

// Оценка одного судьи по одному критерию для одного вызванного участника
// (DrawParticipant.scored=true) — параллельно обычному JudgeScore, но с
// диапазоном/смыслом критерия вместо единой шкалы judgingMaxScore.
// clientSubmissionId — тот же офлайн-паттерн идемпотентности, что и у
// JudgeScore (CLAUDE.md §17).
model FinalJudgeScore {
  id                 String          @id @default(cuid())
  drawParticipantId  String
  drawParticipant    DrawParticipant @relation(fields: [drawParticipantId], references: [id], onDelete: Cascade)
  judgeAssignmentId  String
  judgeAssignment    JudgeAssignment @relation(fields: [judgeAssignmentId], references: [id])
  criterionId        String
  criterion          FinalCriterion  @relation(fields: [criterionId], references: [id])
  value              Int
  clientSubmissionId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([drawParticipantId, judgeAssignmentId, criterionId])
  @@index([criterionId])
  @@index([judgeAssignmentId])
}

// Итог финала на одного участника — ОТДЕЛЬНО от RoundResult/AdvancementStatus
// (там "прошёл/не прошёл", здесь — место 1..N, раундов после финала не
// бывает). criteriaTotals/totalScore — суммы по всем судьям (никаких весов/
// нормализации). place — null, пока не разрешена полная ничья (тогда
// tieGroupKey не null — участники одной группы делят один ключ и ждут
// решения перетанцовки).
model FinalResult {
  id             String           @id @default(cuid())
  roundId        String
  round          Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration     @relation(fields: [registrationId], references: [id])
  finalSessionId String
  finalSession   FinalSession     @relation(fields: [finalSessionId], references: [id], onDelete: Cascade)
  role           RegistrationRole
  totalScore     Int
  criteriaTotals Json // { [criterionId]: number }
  place          Int?
  tieGroupKey    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([roundId, registrationId])
  @@index([finalSessionId])
  @@index([registrationId])
}

// ---------------------------------------------------------------------------
// Официальный протокол результатов и публикация (Этап 10)
// ---------------------------------------------------------------------------
// Result агрегирует путь участника через дивизион (RoundResult обычных
// раундов / FinalResult финала) в одну официальную запись протокола —
// CLAUDE.md §10/§29/§39/§62 требуют, чтобы это не менялось незаметно.
// Версионируется, как Draw/CompetitionRules (docs/00_DECISIONS.md, A1/A5):
// calculateResults() создаёт version 1, correctResult() создаёт version N+1
// с обязательной причиной — старая строка не удаляется и не переписывается
// (CLAUDE.md §51). Текущая строка = последняя version на (divisionId,
// registrationId). publishedAt/publishedById ставятся не по одному Result, а
// разом на все Result соревнования через publishCompetitionResults (см.
// docs/00_DECISIONS.md — публикация мест только по всему соревнованию сразу,
// уточнено пользователем 2026-09-04) и НЕ переставляются автоматически более
// поздней коррекцией — publishedAt хранит момент первой публикации.
enum ResultStatus {
  FINALIST // дошёл до финального раунда дивизиона — placement заполнен
  ELIMINATED // выбыл раньше — placement всегда null (CLAUDE.md §16, не выдумываем место)
}

model Result {
  id                 String       @id @default(cuid())
  divisionId         String
  division           Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  registrationId     String
  registration       Registration @relation(fields: [registrationId], references: [id])
  version            Int
  // Последний раунд дивизиона (обычный, не TIE_BREAK), в котором участник
  // реально танцевал — либо финал (status=FINALIST), либо раунд, на котором
  // выбыл (status=ELIMINATED).
  roundReachedId     String
  roundReached       Round        @relation("ResultRoundReached", fields: [roundReachedId], references: [id])
  status             ResultStatus
  placement          Int? // место в финале (роль считается отдельно, как и везде в движке); null при ELIMINATED
  calculationVersion String       @default("v1")
  publishedAt        DateTime?
  publishedById      String?
  publishedBy        User?        @relation("ResultPublishedBy", fields: [publishedById], references: [id])
  createdById        String
  createdBy          User         @relation("ResultCreatedBy", fields: [createdById], references: [id])
  reason             String? // обязателен при исправлении (version > 1) — не при первом расчёте
  createdAt          DateTime     @default(now())

  @@unique([divisionId, registrationId, version])
  @@index([divisionId, registrationId])
  @@index([createdById])
  @@index([publishedById])
  @@index([registrationId])
  @@index([roundReachedId])
}

// ---------------------------------------------------------------------------
// Аудит / идемпотентность
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model CompetitionEvent {
  id            String   @id @default(cuid())
  competitionId String?
  roundId       String?
  heatId        String?
  eventType     String
  payload       Json
  occurredAt    DateTime @default(now())
  actorId       String?
  actor         User?    @relation("CompetitionEventActor", fields: [actorId], references: [id])

  @@index([competitionId, occurredAt])
  @@index([actorId])
}

// Идемпотентность для draw/расчёта результатов/публикации (03 §26).
// Оценки судей используют собственный clientSubmissionId — сюда не относится.
model IdempotencyKey {
  id        String   @id @default(cuid())
  scope     String // напр. "draw.generate", "result.publish"
  key       String
  createdAt DateTime @default(now())

  @@unique([scope, key])
}

// ---------------------------------------------------------------------------
// Регистрация и check-in участников (этап 3)
// ---------------------------------------------------------------------------
// Competitor как отдельная сущность не заводится: аккаунт обязателен для
// участия (решение пользователя), поэтому регистрация ссылается напрямую на
// уже существующий layer-1 Dancer — заводить параллельную таблицу с теми же
// полями (имя, город, аватар) было бы дублированием.

enum RegistrationRole {
  LEADER
  FOLLOWER
}

// SCRATCHED — участник снялся сам/его сняли ДО исхода на площадку;
// DISQUALIFIED — решение по нарушению (см. Penalty/DQ на будущих этапах).
// Явка (пришёл/не пришёл) — не здесь, а в CheckIn (docs/00_DECISIONS.md, A6).
enum RegistrationStatus {
  REGISTERED
  SCRATCHED
  DISQUALIFIED
}

enum CheckInStatus {
  CHECKED_IN
  LATE
  NO_SHOW
}

// PENDING — участник выбрал роль, отличную от подсказки по полу, решение
// ждёт EVENT_ADMIN/HEAD_JUDGE (docs/00_DECISIONS.md). APPROVED — роль
// участника подтверждена как есть. REJECTED — роль возвращена к подсказке
// по полу.
enum RegistrationRoleOverrideStatus {
  PENDING
  APPROVED
  REJECTED
}

model Registration {
  id             String             @id @default(cuid())
  competitionId  String
  competition    Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  divisionId     String
  division       Division           @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  dancerId       String
  dancer         Dancer             @relation(fields: [dancerId], references: [id])
  // Действующая роль. Пока roleOverrideStatus = PENDING, здесь лежит
  // безопасное значение по умолчанию (подсказка по полу), а не то, что
  // попросил участник, — на случай, если запрос так и не будет рассмотрен
  // (docs/00_DECISIONS.md).
  role           RegistrationRole
  status         RegistrationStatus @default(REGISTERED)
  registeredById String // кто оформил: сам участник или админ (CLAUDE.md §28 — регистрация аудируется)
  registeredBy   User               @relation("RegistrationRegisteredBy", fields: [registeredById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Роль, которую в реальности выбрал участник, если она разошлась с
  // подсказкой по полу; null, если подсказка не противоречила выбору или
  // пол профиля не заполнен (сравнивать не с чем — противоречия нет).
  requestedRole            RegistrationRole?
  roleOverrideStatus       RegistrationRoleOverrideStatus?
  roleOverrideReviewedById String?
  roleOverrideReviewedBy   User?                           @relation("RegistrationRoleOverrideReviewer", fields: [roleOverrideReviewedById], references: [id])
  roleOverrideReviewedAt   DateTime?

  // Оплата (redesign, 2026-09-09) — только факт оплачено/не оплачено, без
  // сумм/валюты/интеграции с платёжной системой (по решению пользователя —
  // расширится позже отдельной задачей). Переключается вручную организатором
  // (registration:manage), не автоматически ничем.
  isPaid Boolean   @default(false)
  paidAt DateTime?

  checkIn              CheckIn?
  drawParticipations   DrawParticipant[]
  roundResults         RoundResult[]
  finalResults         FinalResult[]
  finalPairsAsLeader   FinalPair[]          @relation("FinalPairLeader")
  finalPairsAsFollower FinalPair[]          @relation("FinalPairFollower")
  officialResults      Result[]
  audienceVoteBallots  AudienceVoteBallot[]
  audienceVoteWins     AudienceVoteWinner[]

  // Одна роль на дивизион на человека — нельзя зарегистрироваться в одном
  // дивизионе одновременно и LEADER, и FOLLOWER (docs/00_DECISIONS.md, B6).
  @@unique([competitionId, divisionId, dancerId])
  @@index([competitionId, divisionId])
  @@index([dancerId])
  // Пул жеребьёвки/добора помощников фильтрует именно так — divisionId+
  // role+status, БЕЗ competitionId в WHERE (draw-engine.ts, draw-helper.ts,
  // и groupBy на странице соревнования) — существующий составной индекс
  // (competitionId, divisionId, ...) для такого запроса бесполезен, т.к.
  // competitionId не задан. При текущем размере таблиц эффекта не даёт
  // (Postgres и так выбирает seq scan на маленькой таблице), но так и
  // должно быть проиндексировано по мере роста числа участников.
  @@index([divisionId, role, status])
  @@index([registeredById])
  @@index([roleOverrideReviewedById])
}

model CheckIn {
  id             String        @id @default(cuid())
  registrationId String        @unique
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  competitionId  String // денормализовано для уникальности bib-номера в рамках соревнования (docs/00_DECISIONS.md, B4)
  competition    Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  status         CheckInStatus
  bibNumber      String?
  checkedInAt    DateTime      @default(now())
  checkedInById  String
  checkedInBy    User          @relation("CheckInCheckedInBy", fields: [checkedInById], references: [id])

  @@unique([competitionId, bibNumber])
  @@index([registrationId])
  @@index([checkedInById])
}

// ---------------------------------------------------------------------------
// Приз зрительских симпатий (Audience Vote) — отдельная от судейского
// движка подсистема голосования, по одной на Division. Жизненный цикл
// ЛИНЕЙНЫЙ, без повторного открытия: IDLE -> RUNNING -> CLOSED -> PUBLISHED
// (и обратно в CLOSED только через явный Unpublish с причиной, как у
// Result/unpublishCompetitionResults). Явное упрощение по сравнению с
// Round/Heat — здесь нет PAUSED и нет возврата CLOSED -> RUNNING (см. план
// реализации, whimsical-juggling-thompson.md).
// ---------------------------------------------------------------------------

enum AudienceVoteMode {
  GENERAL // один голос за любого участника категории (любой роли)
  BY_ROLE // отдельно голос за партнёра и за партнёршу, по одному от пользователя
}

enum AudienceVoteDisplayMode {
  NUMBER_ONLY
  NUMBER_AND_NAME
}

enum AudienceVoteStatus {
  IDLE
  RUNNING
  CLOSED
  PUBLISHED
}

// ANY — только режим GENERAL (голос не привязан к роли участника);
// LEADER/FOLLOWER — режим BY_ROLE, а также ключ роли в AudienceVoteWinner
// независимо от режима (GENERAL хранит своего единственного победителя под ANY).
enum AudienceVoteRole {
  LEADER
  FOLLOWER
  ANY
}

model AudienceVote {
  id         String   @id @default(cuid())
  divisionId String   @unique
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  mode        AudienceVoteMode
  displayMode AudienceVoteDisplayMode @default(NUMBER_AND_NAME)
  infoText    String?

  status        AudienceVoteStatus @default(IDLE)
  statusVersion Int                @default(0) // optimistic locking, как Competition/Round

  startedAt   DateTime?
  startedById String?
  startedBy   User?     @relation("AudienceVoteStartedBy", fields: [startedById], references: [id])
  closesAt    DateTime? // null = без таймера, закрытие только вручную

  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("AudienceVoteClosedBy", fields: [closedById], references: [id])

  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("AudienceVotePublishedBy", fields: [publishedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ballots AudienceVoteBallot[]
  winners AudienceVoteWinner[]
}

model AudienceVoteBallot {
  id             String           @id @default(cuid())
  audienceVoteId String
  audienceVote   AudienceVote     @relation(fields: [audienceVoteId], references: [id], onDelete: Cascade)
  voterUserId    String
  voterUser      User             @relation("AudienceVoteBallotVoter", fields: [voterUserId], references: [id], onDelete: Cascade)
  role           AudienceVoteRole // ANY для GENERAL, LEADER/FOLLOWER для BY_ROLE
  registrationId String
  registration   Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Сам механизм "1 голос на роль на пользователя" — зритель может передумать
  // (апсерт по этому ключу), пока голосование RUNNING, но не проголосовать
  // дважды за разных участников одновременно.
  @@unique([audienceVoteId, voterUserId, role])
  @@index([audienceVoteId, registrationId])
}

model AudienceVoteWinner {
  id             String           @id @default(cuid())
  audienceVoteId String
  audienceVote   AudienceVote     @relation(fields: [audienceVoteId], references: [id], onDelete: Cascade)
  role           AudienceVoteRole
  registrationId String
  registration   Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  voteCount      Int // снимок числа голосов на момент подтверждения организатором
  confirmedById  String
  confirmedBy    User             @relation("AudienceVoteWinnerConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt    DateTime         @default(now())

  @@unique([audienceVoteId, role, registrationId])
  @@index([registrationId])
}

// ---------------------------------------------------------------------------
// Notification & Subscription Engine
// ---------------------------------------------------------------------------
// Независимый модуль: реагирует на доменные события, происходящие в Event
// Engine (Event/School) и в JNJ Competition Engine (Competition/Round/Heat/
// Registration/Result выше), не дублирует и не меняет их модели/бизнес-
// логику — только читает то, что нужно для рассылки. Список доменных
// событий, их приоритет/шаблон/тип аудитории — конфигурация в
// src/lib/notifications/domain-event-registry.ts (по образцу уже
// существующего src/lib/events/event-type-registry.ts), не if/else в коде.
//
// Subscription — универсальная модель (type + targetId), а не отдельная
// таблица на каждый тип цели: добавление нового SubscriptionType не требует
// новой миграции самой таблицы Subscription.
// ORGANIZER (NOTIF-001, 2026-09-16) — targetId = User.id (Event.createdById),
// НЕ School: у организатора без школы (свободный Event.organizerName) тоже
// должна быть возможность подписаться именно на него, не только через
// SCHOOL. Более раннее решение "подписка на организатора = SCHOOL" отменено.
// STYLE/ARTIST из ТЗ сознательно не заведены сейчас — в схеме нет
// справочника стилей танца (только свободный текст School.directions/
// PartyDetails.musicStyles), заводить подписку не на что; универсальная
// модель позволит добавить их позже без переделки этой таблицы.
enum SubscriptionType {
  EVENT
  SCHOOL
  CITY
  COUNTRY
  EVENT_TYPE // значение — код EventFormat (PARTY/MASTERCLASS/...)
  INSTRUCTOR // значение — id Teacher
  ORGANIZER // значение — id User (Event.createdById)
  // Рассылка держателям конкретного Pass (2026-09-17, план
  // docs/FESTIVAL_UI_TO_DB_PLAN.md, решение №1) — значение targetId у
  // Broadcast/Notification в этом случае = id Pass, а не Subscription.
  // Аудитория резолвится держателями активного Ticket на этот Pass, а не
  // строками Subscription — расширение перечисления целей рассылки, не
  // самого механизма подписок.
  PASS
}

enum SubscriptionSource {
  USER // пользователь подписался сам
  SYSTEM // подписка создана автоматически — зарезервировано, сейчас не используется
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SubscriptionType
  targetId  String // смысл зависит от type: id School/City/Country/Event/Teacher либо код EventFormat
  source    SubscriptionSource @default(USER)
  createdAt DateTime           @default(now())

  @@unique([userId, type, targetId])
  @@index([type, targetId])
  @@index([userId])
}

enum NotificationChannel {
  IN_APP
  WEB_PUSH
  EMAIL
  TELEGRAM
  MOBILE_PUSH
  WHATSAPP
}

enum EmailFrequency {
  IMMEDIATE
  DAILY_DIGEST
  WEEKLY_DIGEST
}

model NotificationPreference {
  // Follow (Subscription) и Preference — разные уровни: подписка решает "на
  // что я слежу", Preference — "что именно и как мне об этом присылать".
  // Один на пользователя, создаётся с дефолтами при первом обращении.
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventFormatsEnabled EventFormat[] // какие форматы событий интересны при подписке на город/школу/тип
  notifyReminders     Boolean       @default(true)
  reminderHoursBefore Int[] // напр. [24, 2] — за сколько часов напоминать
  notifyChanges       Boolean       @default(true) // изменение времени/места
  notifyCancellations Boolean       @default(true)

  channelsEnabled NotificationChannel[]
  emailFrequency  EmailFrequency        @default(IMMEDIATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationEndpoint {
  // Нужен только каналам с собственными регистрационными данными на
  // устройстве/у провайдера (Web Push сейчас; Telegram/Mobile Push — когда
  // будут реализованы). EMAIL берёт адрес из User.email напрямую, IN_APP
  // отдельного endpoint не требует вообще — специально не создаю лишние
  // строки под них.
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  endpoint  String // Web Push subscription endpoint URL / telegram chatId / FCM-APNS token
  provider  String?
  metadata  Json? // напр. { p256dh, auth } для Web Push
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel, endpoint])
  @@index([userId, channel])
}

// Telegram — привязка аккаунта через одноразовую ссылку (Delivery Engine,
// Telegram provider). Бот физически не может узнать chatId человека по email
// — только когда человек сам нажмёт Start в Telegram с этим токеном в
// payload (/start <token>), см. src/server/notifications/telegram-link.ts.
// token генерируется явно приложением через crypto.randomBytes (НЕ через
// Prisma @default(cuid()) — это одноразовая ссылка привязки аккаунта,
// AUTH_SECURITY_SPEC.md требует не полагаться на предсказуемость чужих
// генераторов id для чего-либо похожего на секрет). Короткий TTL (10 минут)
// и одноразовость (consumedAt) — токен не должен быть годным долго, если
// случайно попадёт не в те руки (кто-то другой привязал бы СВОЙ Telegram к
// ЧУЖОМУ аккаунту сайта).
model TelegramLinkToken {
  token      String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum NotificationPriority {
  INFO
  IMPORTANT
  URGENT
}

model NotificationTemplate {
  // key совпадает с ключом в domain-event-registry.ts (напр. "EVENT_PUBLISHED").
  // Тексты не зашиты в бизнес-логику (CLAUDE.md-стиль §16 этого документа) —
  // рендерятся простой {{var}}-подстановкой над этими шаблонами.
  id                String                @id @default(cuid())
  key               String                @unique
  titleTemplate     String
  bodyTemplate      String
  deepLinkTemplate  String?
  defaultPriority   NotificationPriority  @default(INFO)
  supportedChannels NotificationChannel[]
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model NotificationJob {
  // Сырое доменное событие в очереди НА audience resolution — до того, как
  // определена персональная аудитория (см. emitDomainEvent()). Один Job
  // после обработки может породить много строк Notification (по одной на
  // получателя) либо ни одной, если аудитория пуста.
  id             String                @id @default(cuid())
  eventType      String // ключ из domain-event-registry.ts
  payload        Json
  status         NotificationJobStatus @default(PENDING)
  attemptCount   Int                   @default(0)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  errorMessage   String?
  idempotencyKey String                @unique // напр. "EVENT_PUBLISHED:event_123" — повторный emit того же события не создаёт второй job
  createdAt      DateTime              @default(now())

  @@index([status, nextRetryAt])
}

model Notification {
  // Персональное сообщение конкретному пользователю — то, что видно в
  // Notification Center. Один Notification может иметь несколько
  // NotificationDelivery (по одной на включённый канал).
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // ключ из domain-event-registry.ts, либо "BROADCAST" (см. Broadcast ниже — не через шаблон/job)
  priority       NotificationPriority @default(INFO)
  title          String
  body           String
  entityType     String? // для deep link, напр. "EVENT" / "SCHOOL" / "COMPETITION"
  entityId       String?
  deepLink       String?
  isRead         Boolean              @default(false)
  readAt         DateTime?
  idempotencyKey String               @unique // напр. "EVENT_PUBLISHED:event_123:user_456" — защита от дублей при повторной/параллельной обработке job'а
  createdAt      DateTime             @default(now())

  // Ручная рассылка (Broadcast, см. ниже) — заполнено только для type="BROADCAST".
  broadcastId String?
  broadcast   Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  deliveries NotificationDelivery[]

  @@index([broadcastId])
  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                        @default(0)
  lastAttemptAt     DateTime?
  nextRetryAt       DateTime?
  errorCode         String?
  errorMessage      String?
  providerMessageId String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([notificationId, channel])
  @@index([status, nextRetryAt])
}

// Broadcast — ручная рассылка админом (Control Center), НЕ через
// DomainEventRegistry/NotificationTemplate: текст вводит админ вживую в
// момент отправки, аудитория уже известна на входе (не резолвится later
// job'ом). targetType=null означает "все пользователи"; иначе — подписчики
// конкретной цели (та же модель type+targetId, что и Subscription).
// targetLabel — СНИМОК отображаемого имени цели на момент отправки (школа/
// город и т.п. могут быть переименованы или удалены позже, история рассылки
// должна остаться читаемой, CLAUDE.md §50-51). Строка не редактируется и не
// удаляется после отправки — это лог реального действия, не черновик.
model Broadcast {
  id              String            @id @default(cuid())
  title           String
  body            String
  deepLink        String?
  targetType      SubscriptionType?
  targetId        String?
  targetLabel     String
  recipientCount  Int
  sentById        String
  sentBy          User              @relation(fields: [sentById], references: [id])
  clientRequestId String            @unique // идемпотентность — повторный клик/ретрай не отправляет второй раз
  createdAt       DateTime          @default(now())

  notifications Notification[]

  @@index([sentById])
}

// Subscription & Notification Control Center (админка, Phase 9 из ТЗ
// Notification Engine) — настраиваемая оценочная цена доставки за канал.
// НЕ реальный биллинг: ни Resend, ни Web Push/Telegram не дают API с
// фактической стоимостью конкретной рассылки (проверено при реализации,
// см. docs/PROGRESS.md) — админ сам вводит цену за 1000 доставок (напр. по
// своему тарифу Resend), дашборд считает объём × цену как ОЦЕНКУ, честно
// подписанную как таковая (CLAUDE.md §46/§60 — не выдумываем реальные суммы).
// IN_APP сюда не входит — этот канал не уходит вовне, стоимость всегда 0.
model NotificationChannelPrice {
  channel          NotificationChannel @id
  pricePerThousand Decimal             @default(0) @db.Decimal(10, 4)
  currency         String              @default("USD")
  updatedAt        DateTime            @updatedAt
  updatedById      String?
  updatedBy        User?               @relation("NotificationChannelPriceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}
