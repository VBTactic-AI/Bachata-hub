# Локальная разработка (npm run dev). В Docker Compose эти же переменные
# задаются через .env рядом с docker-compose.yml (docker compose читает его
# автоматически) — без них контейнер откажется стартовать (см. docker-compose.yml).
#
# На Supabase (serverless-хостинг вроде Vercel) в конец query-строки идёт
# "&pgbouncer=true&connection_limit=5".
#
# Про connection_limit — важно, тут были грабли (замерено 2026-09-08):
# сначала здесь стояло "connection_limit=1" (борьба с медленным холодным
# старт'ом serverless-функции, 2026-09-07). Но 1 соединение означает, что
# ВСЕ Promise.all в приложении исполняются строго последовательно — пул
# просто не может выдать второе соединение. Замер на живой БД: 9
# параллельных запросов при connection_limit=1 — 1475мс, при 5 — 552мс,
# при 10 — 402мс. То есть единица обнуляла всю параллельность, которую код
# специально выстраивает через Promise.all.
# 5 — компромисс: параллельность есть, но каждый инстанс serverless-функции
# не открывает большой пул к пулеру (их может быть много одновременно).
# Не ставьте 1. Не ставьте и десятки — упрётесь в лимит клиентских
# соединений пулера при нескольких параллельных инстансах функции.
# На локальном Postgres без pgbouncer (как ниже) параметр не нужен.
DATABASE_URL="postgresql://bachata:bachata@localhost:5432/bachata_hub"

# Только для Prisma CLI (migrate deploy/dev, db execute) — на Supabase
# DATABASE_URL обычно указывает на transaction-pooler (:6543, pgbouncer=true),
# а миграциям нужны сессионные фичи, которых он не даёт (migrate deploy может
# зависнуть или упасть). DIRECT_URL — отдельная строка подключения БЕЗ
# pgbouncer=true (Supabase Dashboard → Database → Connection string →
# "Session pooler" или "Direct connection"). На локальном Postgres из
# docker-compose можно оставить тем же значением, что и DATABASE_URL.
DIRECT_URL="postgresql://bachata:bachata@localhost:5432/bachata_hub"

# ОБЯЗАТЕЛЬНО замените оба значения ниже на свои случайные секреты перед
# любым запуском вне вашей машины (staging/прод/публичный Docker-хост) —
# это ключ подписи сессионных JWT: кто знает секрет, может выписать себе
# cookie от имени любого пользователя. Сгенерировать: `openssl rand -base64 32`.
NEXTAUTH_SECRET="REPLACE_ME_generate_with_openssl_rand_base64_32"
SESSION_SECRET="REPLACE_ME_generate_with_openssl_rand_base64_32"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Realtime — браузер подписывается напрямую (без сервера-посредника,
# 2026-09-07: тот обрывался и холодно стартовал заново каждые ~55-60с на
# Vercel serverless). Сервер только выдаёт короткоживущий токен на конкретный
# раунд после обычной проверки прав — RLS-политики JudgeScore/FinalJudgeScore
# проверяют его подпись/claim, не пускают никого другого.
# С 2026-09-11 эти же URL/ключ используются ЕЩЁ и для настоящего Supabase
# Auth (вход через Google/Apple/email, MFA) — src/lib/supabase/{client,server,
# middleware}.ts. Сами OAuth-провайдеры (client id/secret Google, Team
# ID/Key ID/.p8-ключ Apple) настраиваются в Supabase Dashboard → Authentication
# → Providers, НЕ через переменные окружения этого приложения — секреты
# провайдеров хранит и использует сам Supabase Auth, в код/env приложения
# они не попадают.
# project-ref можно взять из имени пользователя в DATABASE_URL пула
# (postgres.<project-ref>).
SUPABASE_URL="https://REPLACE_ME_project_ref.supabase.co"
# service_role — только сервер (createServiceRoleClient и т.п.), в браузер
# никогда не попадает. Dashboard → Project Settings → API → Project API keys.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME_service_role_secret"
# anon/URL с NEXT_PUBLIC_ — эти два НЕ секреты, уходят в браузер осознанно.
NEXT_PUBLIC_SUPABASE_URL="https://REPLACE_ME_project_ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME_anon_public_key"
# СЕКРЕТ — подписывает короткоживущие токены доступа к раунду для Realtime.
# Dashboard → Project Settings → API → "JWT Settings" → "JWT Secret".
SUPABASE_JWT_SECRET="REPLACE_ME_jwt_secret"

# Vercel REST API (страница /admin/database — посещения сайта, события
# Web Analytics в этом месяце, статус последнего деплоя). Публичный API,
# подтверждено по офиц. документации 2026-09-12: vercel.com/docs/rest-api.
# Без этих переменных раздел просто показывает "не подключено" — ничего не
# падает и не выдумывает цифры.
# VERCEL_API_TOKEN — создать вручную: vercel.com/account/tokens → Create
# Token. Программно получить нельзя. Рекомендуется поставить срок действия.
# ВНИМАНИЕ: у токенов Vercel нет ограничения "только чтение" — токен даёт
# полный доступ к аккаунту/команде (деплой, удаление проектов и т.д.), не
# только к Analytics. Храните как обычный секрет, не публикуйте.
VERCEL_API_TOKEN="REPLACE_ME_vercel_access_token"
# Project Settings → General → "Project ID" в Vercel Dashboard (или имя
# проекта — Vercel API принимает оба варианта).
VERCEL_PROJECT_ID="REPLACE_ME_vercel_project_id"
# Только если проект принадлежит команде (Team), а не личному аккаунту —
# Team Settings → General → "Team ID". Для личного аккаунта оставить пустым.
VERCEL_TEAM_ID=""

# Notification & Subscription Engine — Delivery Engine (Phase 5).
#
# Web Push. Сгенерировать пару: `node -e "const{createECDH}=require('crypto');
# const e=createECDH('prime256v1');e.generateKeys();let priv=e.getPrivateKey();
# if(priv.length<32)priv=Buffer.concat([Buffer.alloc(32-priv.length),priv]);
# console.log('VAPID_PUBLIC_KEY='+e.getPublicKey().toString('base64url'));
# console.log('VAPID_PRIVATE_KEY='+priv.toString('base64url'));"`
# (обычный `web-push generate-vapid-keys` из npm-пакета web-push даёт тот же
# формат ключей — можно и так, если пакет доступен для установки в вашем
# окружении; здесь сгенерировано без него, см. web-push-provider.ts).
# ВАЖНО: пока это не npm-пакет web-push, а самодельный HTTP-вызов без
# шифрования payload (см. комментарий в web-push-provider.ts) — уведомления
# приходят с общим текстом, не персональным title/body. NEXT_PUBLIC_ —
# публичный ключ уходит в браузер осознанно (так и задуман Web Push), приватный
# — только сервер.
VAPID_PUBLIC_KEY="REPLACE_ME_vapid_public_key_base64url"
VAPID_PRIVATE_KEY="REPLACE_ME_vapid_private_key_base64url"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="REPLACE_ME_same_value_as_VAPID_PUBLIC_KEY"
# Контактный адрес в VAPID JWT (aud/sub) — по спецификации должен быть
# рабочим mailto: или https:, на случай если push-провайдер захочет связаться
# по поводу вашего сервера.
VAPID_SUBJECT="mailto:admin@REPLACE_ME.example"

# Email — Resend (https://resend.com), REST API напрямую через fetch, без
# SDK-пакета (см. email-provider.ts). Без ключа канал просто не отправляет,
# ошибка попадает в NotificationDelivery.errorMessage — ничего не падает.
RESEND_API_KEY="REPLACE_ME_resend_api_key"
RESEND_FROM_EMAIL="Bachata HUB <notifications@REPLACE_ME.example>"

# Секрет для /api/cron/notifications/sweep — retry для Notification Engine.
# Vercel Cron (см. vercel.json) сам подставляет "Authorization: Bearer
# <CRON_SECRET>" на свои вызовы; для дополнительного внешнего пингера
# (cron-job.org и т.п., нужен на Hobby-плане для более частого ретрая, чем
# раз в сутки) настройте тот же секрет в заголовке x-cron-secret.
# Сгенерировать: `openssl rand -base64 32`.
CRON_SECRET="REPLACE_ME_generate_with_openssl_rand_base64_32"

# Временный Performance Diagnostic Mode (docs/PROGRESS.md) — измерение узких
# мест по критическим действиям (судейство/жеребьёвка/раунды/результаты).
# По умолчанию ВЫКЛЮЧЕН. Оба флага нужны вместе для полной картины: первый
# включает серверные замеры (Prisma query log, консоль, /api/_debug/perf),
# второй — клиентскую обёртку fetch и debug-панель внизу справа. Значения
# нигде не попадают в production-сборку сами по себе — задайте их только в
# своём .env.local на время тестовой сессии, затем удалите/верните в false.
PERFORMANCE_DEBUG=false
NEXT_PUBLIC_PERFORMANCE_DEBUG=false
