# Локальная разработка (npm run dev). В Docker Compose эти же переменные
# задаются через .env рядом с docker-compose.yml (docker compose читает его
# автоматически) — без них контейнер откажется стартовать (см. docker-compose.yml).
#
# На Supabase (serverless-хостинг вроде Vercel) добавьте в конец query-строки
# "&connection_limit=1" — без этого Prisma пытается открыть СВОЙ пул из
# нескольких соединений через pgbouncer (который сам уже пуллер), что на
# холодном старте serverless-функции ощутимо тормозит (найдено вживую,
# 2026-09-07: ~20 секунд ожидания ответа сервера на каждый новый вызов).
# На локальном Postgres без pgbouncer (как ниже) это не нужно.
DATABASE_URL="postgresql://bachata:bachata@localhost:5432/bachata_hub"

# Только для Prisma CLI (migrate deploy/dev, db execute) — на Supabase
# DATABASE_URL обычно указывает на transaction-pooler (:6543, pgbouncer=true),
# а миграциям нужны сессионные фичи, которых он не даёт (migrate deploy может
# зависнуть или упасть). DIRECT_URL — отдельная строка подключения БЕЗ
# pgbouncer=true (Supabase Dashboard → Database → Connection string →
# "Session pooler" или "Direct connection"). На локальном Postgres из
# docker-compose можно оставить тем же значением, что и DATABASE_URL.
DIRECT_URL="postgresql://bachata:bachata@localhost:5432/bachata_hub"

# ОБЯЗАТЕЛЬНО замените оба значения ниже на свои случайные секреты перед
# любым запуском вне вашей машины (staging/прод/публичный Docker-хост) —
# это ключ подписи сессионных JWT: кто знает секрет, может выписать себе
# cookie от имени любого пользователя. Сгенерировать: `openssl rand -base64 32`.
NEXTAUTH_SECRET="REPLACE_ME_generate_with_openssl_rand_base64_32"
SESSION_SECRET="REPLACE_ME_generate_with_openssl_rand_base64_32"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Realtime — браузер подписывается напрямую (без сервера-посредника,
# 2026-09-07: тот обрывался и холодно стартовал заново каждые ~55-60с на
# Vercel serverless). Сервер только выдаёт короткоживущий токен на конкретный
# раунд после обычной проверки прав — RLS-политики JudgeScore/FinalJudgeScore
# проверяют его подпись/claim, не пускают никого другого.
# project-ref можно взять из имени пользователя в DATABASE_URL пула
# (postgres.<project-ref>).
SUPABASE_URL="https://REPLACE_ME_project_ref.supabase.co"
# service_role — только сервер (createServiceRoleClient и т.п.), в браузер
# никогда не попадает. Dashboard → Project Settings → API → Project API keys.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME_service_role_secret"
# anon/URL с NEXT_PUBLIC_ — эти два НЕ секреты, уходят в браузер осознанно.
NEXT_PUBLIC_SUPABASE_URL="https://REPLACE_ME_project_ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME_anon_public_key"
# СЕКРЕТ — подписывает короткоживущие токены доступа к раунду для Realtime.
# Dashboard → Project Settings → API → "JWT Settings" → "JWT Secret".
SUPABASE_JWT_SECRET="REPLACE_ME_jwt_secret"

# Временный Performance Diagnostic Mode (docs/PROGRESS.md) — измерение узких
# мест по критическим действиям (судейство/жеребьёвка/раунды/результаты).
# По умолчанию ВЫКЛЮЧЕН. Оба флага нужны вместе для полной картины: первый
# включает серверные замеры (Prisma query log, консоль, /api/_debug/perf),
# второй — клиентскую обёртку fetch и debug-панель внизу справа. Значения
# нигде не попадают в production-сборку сами по себе — задайте их только в
# своём .env.local на время тестовой сессии, затем удалите/верните в false.
PERFORMANCE_DEBUG=false
NEXT_PUBLIC_PERFORMANCE_DEBUG=false
