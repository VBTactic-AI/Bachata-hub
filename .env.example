# Локальная разработка (npm run dev). В Docker Compose эти же переменные
# задаются в docker-compose.yml — .env нужен только вне контейнера.
DATABASE_URL="postgresql://bachata:bachata@localhost:5432/bachata_hub"
NEXTAUTH_SECRET="dev-secret-change-me"
SESSION_SECRET="dev-secret-change-me"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
