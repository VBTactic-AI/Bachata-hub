# Локальная разработка (npm run dev). В Docker Compose эти же переменные
# задаются через .env рядом с docker-compose.yml (docker compose читает его
# автоматически) — без них контейнер откажется стартовать (см. docker-compose.yml).
DATABASE_URL="postgresql://bachata:bachata@localhost:5432/bachata_hub"

# ОБЯЗАТЕЛЬНО замените оба значения ниже на свои случайные секреты перед
# любым запуском вне вашей машины (staging/прод/публичный Docker-хост) —
# это ключ подписи сессионных JWT: кто знает секрет, может выписать себе
# cookie от имени любого пользователя. Сгенерировать: `openssl rand -base64 32`.
NEXTAUTH_SECRET="REPLACE_ME_generate_with_openssl_rand_base64_32"
SESSION_SECRET="REPLACE_ME_generate_with_openssl_rand_base64_32"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Временный Performance Diagnostic Mode (docs/PROGRESS.md) — измерение узких
# мест по критическим действиям (судейство/жеребьёвка/раунды/результаты).
# По умолчанию ВЫКЛЮЧЕН. Оба флага нужны вместе для полной картины: первый
# включает серверные замеры (Prisma query log, консоль, /api/_debug/perf),
# второй — клиентскую обёртку fetch и debug-панель внизу справа. Значения
# нигде не попадают в production-сборку сами по себе — задайте их только в
# своём .env.local на время тестовой сессии, затем удалите/верните в false.
PERFORMANCE_DEBUG=false
NEXT_PUBLIC_PERFORMANCE_DEBUG=false
